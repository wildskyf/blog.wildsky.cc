---
import blog_info from '@/data/blog_info.json';
import { authorProfile } from '@/data/author';
import SchemaOrg from '@/components/SchemaOrg.astro';

const {
  pageName,
  pageDesc,
  pageImage,
  pageType = 'website',
  pagePublished,
  pageUpdated,
  schema,
} = Astro.props;
const pageTitle = `${pageName ?? 404} | ${blog_info.name}`;
const desc = pageDesc;
const imgUrl = pageImage || 'https://blog.wildsky.cc/icons/ms-icon-310x310.png';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const twitterCard = pageImage ? 'summary_large_image' : 'summary';
const currentLocale = Astro.currentLocale === 'en' ? 'en' : 'tw';
const authorUrl = new URL(authorProfile.aboutPaths[currentLocale], Astro.site).toString();
const publishedTime = pagePublished ? new Date(pagePublished).toISOString() : null;
const updatedTime = pageUpdated ? new Date(pageUpdated).toISOString() : publishedTime;
const articleJsonLd =
  pageType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: pageName,
        description: desc,
        url: canonicalUrl,
        inLanguage: currentLocale === 'tw' ? 'zh-Hant' : 'en',
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': canonicalUrl,
        },
        ...(pageImage ? { image: [pageImage] } : {}),
        ...(publishedTime ? { datePublished: publishedTime } : {}),
        ...(updatedTime ? { dateModified: updatedTime } : {}),
        author: {
          '@type': 'Person',
          name: authorProfile.schemaName,
          alternateName: authorProfile.schemaAlternateName,
          url: authorUrl,
          sameAs: authorProfile.sameAs,
        },
        publisher: {
          '@type': 'Person',
          name: authorProfile.schemaName,
          alternateName: authorProfile.schemaAlternateName,
          url: authorUrl,
          sameAs: authorProfile.sameAs,
        },
      }
    : null;

const additionalSchemas = Array.isArray(schema) ? schema : schema ? [schema] : [];
const schemas = [articleJsonLd, ...additionalSchemas].filter(Boolean);
---

<title>{pageTitle}</title>
<meta name="description" content={desc} />
<meta name="author" content={authorProfile.name} />
<link rel="canonical" href={canonicalUrl} />
<link
  rel="alternate"
  type="application/rss+xml"
  title="RSS Feed for Wildsky's Blog"
  href={new URL('rss.xml', Astro.site)}
/>
<link rel="apple-touch-icon" sizes="57x57" href="/icons/apple-icon-57x57.png" />
<link rel="apple-touch-icon" sizes="60x60" href="/icons/apple-icon-60x60.png" />
<link rel="apple-touch-icon" sizes="72x72" href="/icons/apple-icon-72x72.png" />
<link rel="apple-touch-icon" sizes="76x76" href="/icons/apple-icon-76x76.png" />
<link rel="apple-touch-icon" sizes="114x114" href="/icons/apple-icon-114x114.png" />
<link rel="apple-touch-icon" sizes="120x120" href="/icons/apple-icon-120x120.png" />
<link rel="apple-touch-icon" sizes="144x144" href="/icons/apple-icon-144x144.png" />
<link rel="apple-touch-icon" sizes="152x152" href="/icons/apple-icon-152x152.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-icon-180x180.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/icons/android-icon-192x192.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="96x96" href="/icons/favicon-96x96.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png" />
<link rel="manifest" href="/icons/manifest.json" />
<meta name="msapplication-TileImage" content="/icons/ms-icon-144x144.png" />

<meta itemprop="name" content={pageTitle} />
<meta itemprop="description" content={desc} />
<meta itemprop="image" content={imgUrl} />

<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:site" content="@wildskyf" />
<meta name="twitter:creator" content="@wildskyf" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={imgUrl} />
<meta name="twitter:image:src" content={imgUrl} />

<meta property="og:title" content={pageTitle} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={pageType} />
<meta property="og:image" content={imgUrl} />
<meta property="og:description" content={desc} />
<meta property="og:site_name" content={blog_info.name} />
{
  pageType === 'article' && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )
}
{
  pageType === 'article' && updatedTime && (
    <meta property="article:modified_time" content={updatedTime} />
  )
}
{pageType === 'article' && <meta property="article:author" content={authorUrl} />}
<SchemaOrg schema={schemas} />
