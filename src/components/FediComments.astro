---
// Replies to the article's fediverse post, loaded from /api/comments. Stays hidden for articles
// without a post, which is every article published before this section existed.
---

<section id="fedi-comments" class="fedi-comments" aria-labelledby="fedi-comments-title" hidden>
  <h2 id="fedi-comments-title">Fediverse 回覆</h2>
  <p class="fedi-comments-hint" data-comments-hint>
    在<a class="ds-link" data-comments-post target="_blank" rel="noopener noreferrer">這則貼文</a>回覆，內容會顯示在這裡。回覆會公開，通常幾分鐘內更新。
  </p>
  <div class="notes-list" data-comments-list></div>
</section>

<script is:inline>
  (() => {
    const root = document.getElementById('fedi-comments');
    const match = window.location.pathname.match(/^\/posts\/([^/]+)\/?$/);
    if (!root || !match) return;

    fetch(`/api/comments?slug=${match[1]}`, { headers: { accept: 'application/json' } })
      .then((response) => (response.ok ? response.json() : null))
      .then((data) => {
        if (!data || !data.ok || !data.hasPost) return;
        const post = root.querySelector('[data-comments-post]');
        if (data.postUrl) post.href = data.postUrl;
        else root.querySelector('[data-comments-hint]').hidden = true;
        // The function builds this from sanitized fields only.
        root.querySelector('[data-comments-list]').innerHTML = data.html;
        root.hidden = false;
      })
      .catch(() => {});
  })();
</script>
