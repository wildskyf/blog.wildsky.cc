---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import ListLayout from '@/layouts/list.astro';
import { articleMapper } from '@/utils';
import { PAGINATION_PER_PAGE_COUNT } from '@/data/globalConfig';
import { getTranslation } from '@/i18n/utils.ts';
import type { Locale } from '@/i18n/translations.ts';
import { authorProfile } from '@/data/author';

const currentLocale = (Astro.currentLocale === 'en' ? 'en' : 'tw') as Locale;
const t = getTranslation(currentLocale);

const collectionName = currentLocale === 'en' ? 'posts-en' : 'posts-tw';
const astroPostList = await getCollection(collectionName);

const sortedPosts = astroPostList
  .map(articleMapper)
  .sort((a, b) => Number(b.date) - Number(a.date));

const postList = sortedPosts.slice(0, PAGINATION_PER_PAGE_COUNT);

const pageName = currentLocale === 'en' ? 'Home' : '首頁';
const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: "Wildsky's blog",
  url: new URL(getRelativeLocaleUrl(currentLocale, ''), Astro.site).toString(),
  description: t.site.homeDescription,
  author: {
    '@type': 'Person',
    name: authorProfile.schemaName,
    url: new URL(authorProfile.aboutPaths[currentLocale], Astro.site).toString(),
  },
  isPartOf: {
    '@type': 'WebSite',
    name: "Wildsky's blog",
    url: Astro.site?.toString() ?? 'https://blog.wildsky.cc',
  },
};
// Only show next page link if there are more posts than can fit on one page
const hasNextPage = sortedPosts.length > PAGINATION_PER_PAGE_COUNT;
const nextPagePath = hasNextPage ? getRelativeLocaleUrl(currentLocale, 'page/2') : null;
---

<ListLayout
  lang={currentLocale}
  pageName={pageName}
  pageDesc={t.site.homeDescription}
  postList={postList}
  next_page_path={nextPagePath}
  schema={homeSchema}
  currentPage={1}
  lastPage={Math.ceil(sortedPosts.length / PAGINATION_PER_PAGE_COUNT)}
  totalPosts={sortedPosts.length}
>
  <h1 class="sr-only">{pageName}</h1>
</ListLayout>
