---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import ListLayout from '@/layouts/list.astro';
import { articleMapper } from '@/utils';
import { PAGINATION_PER_PAGE_COUNT } from '@/data/globalConfig';
import { getTranslation } from '@/i18n/utils.ts';
import type { Locale } from '@/i18n/translations.ts';
import { authorProfile } from '@/data/author';

const currentLocale = (Astro.currentLocale === 'en' ? 'en' : 'tw') as Locale;
const t = getTranslation(currentLocale);

const collectionName = currentLocale === 'en' ? 'posts-en' : 'posts-tw';
const astroPostList = await getCollection(collectionName);

const sortedPosts = astroPostList
  .map(articleMapper)
  .sort((a, b) => Number(b.date) - Number(a.date));

const postList = sortedPosts.slice(0, PAGINATION_PER_PAGE_COUNT);

const pageName = currentLocale === 'en' ? 'Home' : '首頁';
const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: "Wildsky's blog",
  url: new URL(getRelativeLocaleUrl(currentLocale, ''), Astro.site).toString(),
  description:
    currentLocale === 'en'
      ? 'Technical and reflective notes by Wildsky, focused on AI agent deployment, self-hosting, web development, and systems thinking.'
      : '軟體工程師 Wildsky 的技術與思考筆記，專注於 AI Agent 部署、self-hosting、Web 開發與系統思維。',
  author: {
    '@type': 'Person',
    name: authorProfile.schemaName,
    url: new URL(authorProfile.aboutPaths[currentLocale], Astro.site).toString(),
  },
  isPartOf: {
    '@type': 'WebSite',
    name: "Wildsky's blog",
    url: Astro.site?.toString() ?? 'https://blog.wildsky.cc',
  },
};
// Only show next page link if there are more posts than can fit on one page
const hasNextPage = sortedPosts.length > PAGINATION_PER_PAGE_COUNT;
const nextPagePath = hasNextPage ? getRelativeLocaleUrl(currentLocale, 'page/2') : null;
---

<ListLayout
  lang={currentLocale}
  pageName={pageName}
  pageDesc={t.site.homeDescription}
  postList={postList}
  next_page_path={nextPagePath}
  schema={homeSchema}
>
  <article class={`
    prose prose-lg max-w-none block p-8 lg:px-4
    ${currentLocale === 'tw' ? 'prose-zh tracking-tw-normal' : 'prose-en'}
  `}>
    <div class="not-prose">
      <h1 class="sr-only">{pageName}</h1>
      <div class="w-full flex justify-center">
        <div class="divider w-xs"></div>
      </div>

      {
        currentLocale === 'tw' && (
          <aside class="mx-auto mt-10 max-w-3xl rounded-2xl border border-base-300 bg-base-200/60 p-6 lg:p-8">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-base-content/55">
              Arthur 的評語
            </p>
            <blockquote class="mt-3 text-2xl font-semibold tracking-tw-normal text-base-content lg:text-3xl">
              「很有紀律的混亂邪惡工程師」
            </blockquote>
            <p class="mt-3 text-sm leading-7 text-base-content/70 lg:text-base">
              出自我的 agent Arthur 在 roast 文裡對我的一句總結。
            </p>
            <a
              href="/posts/my-agent-roasts-my-daily-life/"
              class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-primary transition-opacity hover:opacity-80 lg:text-base"
            >
              看 Arthur 怎麼爆料
              <span aria-hidden="true">→</span>
            </a>
          </aside>
        )
      }
    </div>
  </article>
</ListLayout>
