---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import ListLayout from '@/layouts/list.astro';
import SocialBar from '@/components/SocialBar.astro';
import { articleMapper } from '@/utils';
import { PAGINATION_PER_PAGE_COUNT } from '@/data/globalConfig';
import { getTranslation } from '@/i18n/utils.ts';

const currentLocale = Astro.currentLocale || 'tw';
const t = getTranslation(currentLocale);

const astroPostList = await getCollection(`posts-${currentLocale}`);

const sortedPosts = astroPostList
  .map(articleMapper)
  .sort((a, b) => Number(b.date) - Number(a.date));

const postList = sortedPosts.slice(0, PAGINATION_PER_PAGE_COUNT);

const pageName = currentLocale === 'en' ? 'HomePage' : '首頁';
// Only show next page link if there are more posts than can fit on one page
const hasNextPage = sortedPosts.length > PAGINATION_PER_PAGE_COUNT;
const nextPagePath = hasNextPage ? getRelativeLocaleUrl(currentLocale, 'page/2') : null;
---

<ListLayout
  lang={currentLocale}
  pageName={pageName}
  pageDesc={t.site.homeDescription}
  postList={postList}
  next_page_path={nextPagePath}
>
  <article class={`
    prose prose-lg max-w-none block p-8 lg:px-4
    ${currentLocale === 'tw' ? 'prose-zh tracking-tw-normal' : 'prose-en'}
  `}>
    <div class="not-prose">
      <p class={`
        text-md lg:text-lg mb-4
        ${currentLocale === 'tw' ? 'font-sans tracking-wider font-normal' : ''}
      `}>
        {t.site.homeDescription}
      </p>

      <SocialBar class="mb-4" />

      <div class="w-full flex justify-center">
        <div class="divider w-xs"></div>
      </div>
    </div>
  </article>
</ListLayout>
