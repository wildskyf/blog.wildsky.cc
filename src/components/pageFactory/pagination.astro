---
import ListLayout from '@/layouts/list.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '@/i18n/translations.ts';

const currentLocale = (Astro.currentLocale === 'en' ? 'en' : 'tw') as Locale;
const { page } = Astro.props;
const { data, currentPage, lastPage } = page;

const previous_page_path = getRelativeLocaleUrl(currentLocale, `page/${Number(currentPage) - 1}`);
const next_page_path =
  lastPage === currentPage
    ? null
    : getRelativeLocaleUrl(currentLocale, `page/${Number(currentPage) + 1}`);
---

<ListLayout
  {...{
    lang: currentLocale,
    postList: data,
    previous_page_path,
    next_page_path,
  }}
/>
