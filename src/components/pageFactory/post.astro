---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import PageLayout from '@/layouts/page.astro';
import Article from '@/components/Article.astro';
import AuthorBio from '@/components/AuthorBio.astro';
import RelatedPosts from '@/components/RelatedPosts.astro';
import { articleMapper, formatReadingTime } from '@/utils';
import { selectRelatedPosts } from '@/utils/relatedPosts.mjs';

const { lang, entry } = Astro.props;
const { Content } = await render(entry);
const data = articleMapper(entry);
const readingTime = data.readingMinutes ? formatReadingTime(data.readingMinutes, lang) : null;
const series = entry.data.series ?? null;
const translationKey = entry.data.translationKey;
const currentCollection = lang === 'en' ? 'posts-en' : 'posts-tw';
const sameLanguageEntries = await getCollection(currentCollection);
const otherLang = lang === 'en' ? 'tw' : 'en';
const otherCollection = otherLang === 'en' ? 'posts-en' : 'posts-tw';
const translatedEntries = translationKey
  ? (await getCollection(otherCollection)).filter(
      (candidate) => candidate.data.translationKey === translationKey
    )
  : [];

if (translatedEntries.length > 1) {
  throw new Error(`Duplicate ${otherLang} translationKey: ${translationKey}`);
}

const translatedEntry = translatedEntries[0];
const translatedData = translatedEntry ? articleMapper(translatedEntry) : null;
const translation = translatedData
  ? {
      href: `${otherLang === 'en' ? '/en' : ''}/posts/${translatedData.slug}/`,
      hreflang: otherLang === 'en' ? 'en-US' : 'zh-Hant-TW',
      label: otherLang === 'en' ? 'Read in English' : '閱讀中文版',
    }
  : null;
const currentHref = `${lang === 'en' ? '/en' : ''}/posts/${data.slug}/`;
const languageAlternates = translation
  ? [
      {
        hreflang: lang === 'en' ? 'en-US' : 'zh-Hant-TW',
        href: currentHref,
      },
      {
        hreflang: translation.hreflang,
        href: translation.href,
      },
    ]
  : [];
const relatedPosts = selectRelatedPosts(entry, sameLanguageEntries).map(
  ({ entry: related }: { entry: CollectionEntry<'posts-en'> | CollectionEntry<'posts-tw'> }) => {
    const relatedData = articleMapper(related);
    return {
      date: related.data.date,
      href: `${lang === 'en' ? '/en' : ''}/posts/${relatedData.slug}/`,
      title: relatedData.title,
    };
  }
);
---

<PageLayout
  lang={lang}
  pageName={data.title}
  pageDesc={data.excerpt}
  pageImage={data.abs_feature_image}
  pageType="article"
  pagePublished={entry.data.date}
  pageUpdated={entry.data.updated ?? entry.data.date}
  languageAlternates={languageAlternates}
>
  <Article
    {...data}
    lang={lang}
    readingTime={readingTime}
    series={series}
    translation={translation}
  >
    <Content />
  </Article>

  <RelatedPosts lang={lang} posts={relatedPosts} />
  <AuthorBio lang={lang} />
</PageLayout>
