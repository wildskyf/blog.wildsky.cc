---
import { authorProfile } from '@/data/author';

const currentLocale = Astro.props.lang === 'en' ? 'en' : 'tw';
const copy = authorProfile.localeContent[currentLocale];
---

<aside class="ds-bio" lang={currentLocale === 'tw' ? 'zh-Hant-TW' : 'en'}>
  <div class="ds-bio-inner">
    <img
      class="ds-bio-avatar"
      src={authorProfile.avatar.src}
      alt={authorProfile.avatar.alt[currentLocale]}
      width="304"
      height="304"
      loading="lazy"
      decoding="async"
    />

    <div class="ds-bio-body">
      <p class="ds-bio-label">{copy.sectionLabel}</p>

      <h2 class="ds-bio-name">{authorProfile.name}</h2>
      <p class="ds-bio-handle">{copy.handleLabel}</p>

      <p class="ds-bio-text">{copy.subtitle}</p>
      <p class="ds-bio-text">{copy.summary}</p>

      <div class="ds-bio-cta">
        <a class="ds-btn ds-plate" href={copy.primaryCta.href}>{copy.primaryCta.label}</a>
        <a class="ds-btn ds-plate" href={copy.secondaryCta.href}>{copy.secondaryCta.label}</a>
      </div>
    </div>
  </div>
</aside>

<style>
  /* 作者卡：不透明 --bg-surface。
     必須不透明 —— 實測半透明底（舊版 bg-base-200/60）會讓底部礁石剪影透上來，
     亮色主題的 --fg-muted 掉到 4.21（未過 AA）。 */
  .ds-bio {
    position: relative;
    width: min(var(--measure), 100% - var(--page-gutter) * 2);
    margin: 0 auto 64px;
    padding: 28px 30px 32px;
    background: var(--bg-surface);
    border: 1px solid var(--fg-faint);
  }

  /* The Plate 的內框 */
  .ds-bio::before {
    content: '';
    position: absolute;
    inset: 4px;
    pointer-events: none;
    border: 1px solid var(--rule);
  }

  .ds-bio-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .ds-bio-avatar {
    width: 56px;
    height: 56px;
    flex: none;
    object-fit: cover;
    /* 真正的圓形是 The No Radius Rule 的合法例外 */
    border-radius: 50%;
    border: 1px solid var(--rule);
  }

  .ds-bio-body {
    flex: 1;
    min-width: 0;
  }

  .ds-bio-label {
    margin: 0 0 10px;
    font-family: var(--font-label);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.055em;
    font-variant-caps: all-small-caps;
    font-feature-settings:
      'smcp' 1,
      'c2sc' 1;
    color: var(--fg-muted);
  }

  .ds-bio-name {
    margin: 0 0 4px;
    font-family: var(--font-headline);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--fg);
  }

  .ds-bio-handle {
    margin: 0 0 16px;
    font-family: var(--font-label);
    font-size: 15px;
    letter-spacing: 0.015em;
    color: var(--fg-muted);
  }

  .ds-bio-text {
    margin: 0 0 12px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.8;
    color: var(--fg-muted);
  }

  .ds-bio-cta {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  @media (min-width: 640px) {
    .ds-bio-inner {
      flex-direction: row;
      align-items: flex-start;
      gap: 22px;
    }
  }
</style>
