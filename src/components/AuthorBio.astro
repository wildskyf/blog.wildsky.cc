---
import { authorProfile } from '@/data/author';

const currentLocale = Astro.props.lang === 'en' ? 'en' : 'tw';
const copy = authorProfile.localeContent[currentLocale];
---

<aside class="not-prose mt-12 rounded-2xl border border-base-300 bg-base-200/60 p-6 lg:p-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
    <img
      src={authorProfile.avatar.src}
      alt={authorProfile.avatar.alt[currentLocale]}
      loading="lazy"
      decoding="async"
      class="h-14 w-14 shrink-0 rounded-full border border-base-300 object-cover"
    />

    <div class="flex-1">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-base-content/55">
        {copy.sectionLabel}
      </p>

      <div class="mt-2 flex flex-col gap-1">
        <h2 class={`text-xl font-semibold text-base-content ${currentLocale === 'tw' ? 'tracking-tw-normal' : ''}`}>
          {authorProfile.name}
        </h2>
        <p class="text-sm text-base-content/70">{copy.handleLabel}</p>
      </div>

      <p class={`mt-4 text-base text-base-content/85 ${currentLocale === 'tw' ? 'tracking-tw-normal leading-8' : 'leading-7'}`}>
        {copy.subtitle}
      </p>
      <p class={`mt-3 text-base text-base-content/75 ${currentLocale === 'tw' ? 'tracking-tw-normal leading-8' : 'leading-7'}`}>
        {copy.summary}
      </p>

      <div class="mt-5 flex flex-wrap gap-3">
        <a
          href={copy.primaryCta.href}
          class="inline-flex items-center rounded-full bg-primary px-4 py-2 text-sm font-medium text-white transition-colors duration-200 hover:bg-primary/90 hover:text-white"
        >
          {copy.primaryCta.label}
        </a>
        <a
          href={copy.secondaryCta.href}
          class="inline-flex items-center rounded-full border border-base-content/15 px-4 py-2 text-sm font-medium text-base-content transition-colors duration-200 hover:bg-base-100"
        >
          {copy.secondaryCta.label}
        </a>
      </div>
    </div>
  </div>
</aside>
