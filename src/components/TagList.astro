---
const {
  tags = [],
  lang,
  currentTag,
} = Astro.props as {
  tags?: string[];
  lang?: 'tw' | 'en';
  currentTag?: string;
};
const root_path = lang === 'en' ? '/en' : '';
const isLatinTag = (tag: string) => !/[\u3400-\u9fff]/u.test(tag);
---

{
  tags && tags.length > 0 && (
    <div class="ds-taglist">
      {tags.map((tag) => (
        <a
          href={`${root_path}/tags/${tag}`}
          class:list={['ds-tag', tag === currentTag && 'is-current']}
          lang={isLatinTag(tag) ? 'en' : undefined}
        >
          {tag}
        </a>
      ))}
    </div>
  )
}

<style>
  /* 無框、無底色、無 skew。tag 靠留白分隔，不靠符號也不靠框。
     平行四邊形（skewX -12deg）是 v6 的作法，已隨切角一併退役。 */
  .ds-taglist {
    display: flex;
    flex-wrap: wrap;
    column-gap: 18px;
    row-gap: 2px;
  }

  .ds-tag {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-label);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.015em;
    color: var(--fg-muted);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition:
      color var(--t) var(--ease),
      text-decoration-color var(--t) var(--ease);
  }

  .ds-tag:hover,
  .ds-tag:focus-visible {
    color: var(--fg);
    text-decoration-color: var(--accent);
  }

  .ds-tag:lang(en) {
    letter-spacing: 0.045em;
    font-variant-caps: all-small-caps;
    font-feature-settings:
      'smcp' 1,
      'c2sc' 1;
  }

  /* 當前 tag：紅線 ＋ 主要文字色。不填色 —— 填色只屬於 Seal。 */
  .ds-tag.is-current {
    color: var(--fg);
    text-decoration-color: var(--accent);
  }

  @media (max-width: 767px) {
    .ds-taglist {
      column-gap: 14px;
      row-gap: 0;
    }

    .ds-tag {
      min-height: 44px;
    }
  }
</style>
