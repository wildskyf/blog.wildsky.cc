---
import { getTagPath } from '@/utils';

const {
  tags = [],
  lang,
  currentTag,
} = Astro.props as {
  tags?: string[];
  lang?: 'tw' | 'en';
  currentTag?: string;
};
const isLatinTag = (tag: string) => !/[\u3400-\u9fff]/u.test(tag);
---

{
  tags && tags.length > 0 && (
    <div class="ds-taglist">
      {tags.map((tag) => (
        <a
          href={getTagPath(tag, lang)}
          class:list={['ds-tag', tag === currentTag && 'is-current']}
          lang={isLatinTag(tag) ? 'en' : undefined}
        >
          {tag}
        </a>
      ))}
    </div>
  )
}

<style>
  .ds-taglist {
    display: flex;
    flex-wrap: wrap;
    column-gap: 18px;
    row-gap: 4px;
  }

  .ds-tag {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-caps);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
    text-decoration: none;
    transition: color var(--t) var(--ease);
  }

  .ds-tag::before {
    content: '#';
    margin-right: 2px;
    color: var(--rule-strong);
  }

  .ds-tag:lang(en) {
    letter-spacing: 0.2em;
  }

  .ds-tag:hover,
  .ds-tag:focus-visible,
  .ds-tag.is-current {
    color: var(--fg);
  }

  .ds-tag.is-current::before {
    color: var(--glow);
  }

  @media (max-width: 767px) {
    .ds-taglist {
      column-gap: 14px;
      row-gap: 0;
    }

    .ds-tag {
      min-height: 44px;
    }
  }
</style>
