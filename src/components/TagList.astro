---
const {
  tags = [],
  lang,
  currentTag,
} = Astro.props as {
  tags?: string[];
  lang?: 'tw' | 'en';
  currentTag?: string;
};
const root_path = lang === 'en' ? '/en' : '';
---

{
  tags && tags.length > 0 && (
    <div class="ds-taglist">
      {tags.map((tag) => (
        <a
          href={`${root_path}/tags/${tag}`}
          class:list={['ds-tag', tag === currentTag && 'is-current']}
        >
          {tag}
        </a>
      ))}
    </div>
  )
}

<style>
  /* 無框、無底色、無 skew。tag 靠留白分隔，不靠符號也不靠框。
     平行四邊形（skewX -12deg）是 v6 的作法，已隨切角一併退役。 */
  .ds-taglist {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .ds-tag {
    font-family: var(--font-label);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.07em;
    font-variant: small-caps;
    color: var(--fg-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition:
      color var(--t) var(--ease),
      border-color var(--t) var(--ease);
  }

  .ds-tag:hover,
  .ds-tag:focus-visible {
    color: var(--fg);
    border-bottom-color: var(--accent);
  }

  /* 當前 tag：紅線 ＋ 主要文字色。不填色 —— 填色只屬於 Seal。 */
  .ds-tag.is-current {
    color: var(--fg);
    border-bottom-color: var(--accent);
  }

  @media (max-width: 767px) {
    .ds-taglist {
      gap: 14px;
    }
  }
</style>
