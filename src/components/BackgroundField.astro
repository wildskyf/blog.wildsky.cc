---
// 環境層 —— The Organic Layer Rule 的管轄範圍。
// 紀律（DESIGN.md「環境層與文字的分界」，全部是實測結論）：
//   1. 最亮／最暗的元素不得進入 chrome 內側 —— 用 .ds-rail 把它們鎖在外側留白帶
//   2. 暗角用 calc((100% - chrome)/2)，不用百分比
//   3. 全幅微粒的強度由 --env-mote-op 控制，兩主題不同值
// 位置一律用百分比，讓它在 1500px 的首頁與 12000px 的長文都成立。

const BUBBLES = [
  { t: 26, s: 6 },
  { t: 34, s: 9 },
  { t: 45, s: 12 },
  { t: 54, s: 10, teal: true },
  { t: 63, s: 16, teal: true },
  { t: 72, s: 14, teal: true },
  { t: 80, s: 22, teal: true },
  { t: 88, s: 18, teal: true },
];
const BUBBLES_R = [
  { t: 31, s: 8 },
  { t: 43, s: 11 },
  { t: 58, s: 15, teal: true },
  { t: 69, s: 20, teal: true },
  { t: 84, s: 13, teal: true },
];
const SNOW = [22, 37, 51, 66, 78, 91];
const MOTES = [
  [22, 12],
  [37, 22],
  [54, 17],
  [68, 26],
  [81, 20],
  [29, 35],
  [46, 42],
  [62, 38],
  [76, 46],
  [18, 51],
  [41, 56],
  [57, 61],
  [72, 66],
  [33, 71],
  [49, 76],
  [66, 81],
  [25, 86],
  [58, 91],
  [78, 95],
  [44, 99],
];
const FISH = 'M0,10 C8,3 24,3 36,10 C24,17 8,17 0,10 Z M36,10 L46,4 L44,10 L46,16 Z';
---

<div class="ds-field" aria-hidden="true">
  <span class="ds-depth"></span>

  <svg class="ds-strata s1" viewBox="0 0 1440 420" preserveAspectRatio="none">
    <path
      d="M0,58 C90,30 170,72 258,50 C330,32 392,74 470,60 C556,44 620,86 706,68
         C790,50 852,90 940,72 C1024,55 1090,94 1178,76 C1258,60 1330,96 1440,66
         L1440,352 C1350,382 1276,344 1192,364 C1108,384 1042,346 956,366
         C866,386 800,348 712,368 C624,388 560,350 470,370 C384,389 316,352 228,372
         C148,390 78,356 0,378 Z"
    ></path>
  </svg>
  <svg class="ds-strata s2" viewBox="0 0 1440 300" preserveAspectRatio="none">
    <path
      d="M0,40 C110,72 200,26 300,52 C398,78 470,34 566,58 C664,82 740,38 838,62
         C934,86 1008,40 1104,64 C1196,87 1290,44 1440,74 L1440,246
         C1348,270 1262,238 1168,258 C1074,278 990,240 894,264 C798,286 714,246 620,268
         C526,288 442,248 348,270 C254,290 170,250 82,274 C48,282 24,270 0,266 Z"
    ></path>
  </svg>

  <svg width="0" height="0" focusable="false">
    <defs>
      <filter id="ds-deckle-f" x="-3%" y="-8%" width="106%" height="116%">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.012 0.05"
          numOctaves="2"
          seed="17"
          result="noise"></feTurbulence>
        <feDisplacementMap
          in="SourceGraphic"
          in2="noise"
          scale="12"
          xChannelSelector="R"
          yChannelSelector="G"></feDisplacementMap>
      </filter>
    </defs>
  </svg>

  <span class="ds-vignette"></span>

  <span class="ds-grain"></span>

  <span class="ds-caustics"></span>

  <span class="ds-beam b1"></span>
  <span class="ds-beam b2"></span>
  <span class="ds-ember-beacon"></span>
  <svg class="ds-compass-mark" viewBox="0 0 58 58">
    <circle cx="29" cy="29" r="22"></circle>
    <path d="M29 2V14M29 44V56M2 29H14M44 29H56M29 15L34 29L29 43L24 29Z"></path>
  </svg>

  <!-- 魚群：比背景更暗的剪影，橫越畫面 -->
  <svg class="ds-school sc1" viewBox="0 0 210 64" preserveAspectRatio="none">
    <g>
      <path d={FISH} transform="translate(6,10)"></path>
      <path d={FISH} transform="translate(62,32) scale(0.85)"></path>
      <path d={FISH} transform="translate(112,4) scale(0.7)"></path>
      <path d={FISH} transform="translate(140,28)"></path>
      <path d={FISH} transform="translate(40,46) scale(0.6)"></path>
    </g>
  </svg>
  <svg class="ds-school sc2" viewBox="0 0 300 96" preserveAspectRatio="none">
    <g>
      <path
        d="M28,52 C58,26 118,20 162,40 C186,51 210,50 232,42
           C214,60 186,70 158,68 C120,66 66,68 28,52 Z"
      ></path>
      <path d="M232,42 L262,30 L254,46 L266,60 Z"></path>
      <path d={FISH} transform="translate(86,68) scale(0.9)"></path>
    </g>
  </svg>

  <svg class="ds-sea-fan" viewBox="0 0 260 330" preserveAspectRatio="none">
    <path d="M132 330 C128 258 126 198 132 126 C136 82 140 42 150 4"></path>
    <path d="M132 242 C96 214 70 180 48 134 C30 98 20 62 12 20"></path>
    <path d="M130 214 C168 182 194 148 214 104 C230 70 240 38 246 8"></path>
    <path d="M104 218 C92 174 82 132 80 82 M82 162 C58 142 42 120 28 92"></path>
    <path d="M160 190 C170 150 180 112 184 68 M180 130 C204 110 220 88 232 58"></path>
  </svg>
  <svg class="ds-hydroid" viewBox="0 0 180 250" preserveAspectRatio="none">
    <path d="M96 250 C90 202 94 164 86 126 C78 90 86 52 78 8"></path>
    <path d="M88 174 C62 150 50 126 44 98 M86 138 C112 116 124 90 130 62"></path>
    <path d="M44 98 C34 82 24 72 12 66 M130 62 C146 50 158 38 168 22"></path>
    <path d="M78 8 C72 22 68 34 70 48 M12 66 C22 64 30 66 36 74 M168 22 C158 24 150 30 146 40"
    ></path>
  </svg>
  <svg class="ds-school sc3" viewBox="0 0 150 46" preserveAspectRatio="none">
    <g>
      <path d={FISH} transform="translate(8,6) scale(0.8)"></path>
      <path d={FISH} transform="translate(54,22) scale(0.7)"></path>
      <path d={FISH} transform="translate(96,2) scale(0.6)"></path>
    </g>
  </svg>

  <!-- 水母：唯一有生物節奏的東西（收縮推進） -->
  <span class="ds-jelly j1">
    <svg viewBox="0 0 66 130">
      <path
        class="bell"
        d="M4,44 C4,20 18,4 33,4 C48,4 62,20 62,44 C62,50 56,54 50,50
           C45,46 40,52 33,52 C26,52 21,46 16,50 C10,54 4,50 4,44 Z"
      ></path>
      <path class="tendril" d="M18,52 C16,74 22,88 18,112"></path>
      <path class="tendril" d="M27,52 C25,78 31,94 26,124"></path>
      <path class="tendril" d="M39,52 C41,76 35,92 40,120"></path>
      <path class="tendril" d="M48,52 C50,72 44,86 49,108"></path>
    </svg>
  </span>
  <span class="ds-jelly j2">
    <svg viewBox="0 0 66 130">
      <path
        class="bell"
        d="M4,44 C4,20 18,4 33,4 C48,4 62,20 62,44 C62,50 56,54 50,50
           C45,46 40,52 33,52 C26,52 21,46 16,50 C10,54 4,50 4,44 Z"
      ></path>
      <path class="tendril" d="M20,52 C18,76 24,90 19,116"></path>
      <path class="tendril" d="M33,52 C31,80 37,96 32,126"></path>
      <path class="tendril" d="M46,52 C48,74 42,88 47,114"></path>
    </svg>
  </span>

  <!-- 底部礁石與海藻 -->
  <svg class="ds-reef" viewBox="0 0 1440 230" preserveAspectRatio="xMidYMax slice">
    <path
      d="M0,230 L0,150 C14,142 20,120 16,98 C13,82 22,74 30,86 C36,95 34,112 40,126
         C46,139 58,138 62,124 C67,106 60,88 66,72 C71,58 84,60 86,76 C88,94 82,112 88,130
         C94,147 108,150 114,136 C120,121 114,100 122,88 C129,77 140,84 138,98
         C136,116 130,134 138,152 C144,166 158,168 164,154 L172,230 Z"
    ></path>
    <path
      d="M196,230 L200,168 C186,158 178,136 184,116 C189,100 202,102 204,118
         C206,134 200,150 208,164 C214,175 228,174 232,160 C237,142 228,120 236,106
         C243,94 256,100 254,116 C252,134 246,152 254,168 C260,180 274,180 278,166
         L286,230 Z"
    ></path>
    <path
      d="M1050,230 L1046,164 C1032,154 1024,130 1032,110 C1038,94 1052,98 1054,114
         C1056,132 1048,150 1058,166 C1065,177 1080,176 1084,160 C1089,140 1080,118 1090,104
         C1098,92 1112,98 1110,116 C1108,136 1100,154 1110,172 C1117,184 1132,184 1136,168
         L1146,230 Z"
    ></path>
    <path
      d="M1188,230 L1192,146 C1178,134 1172,108 1180,88 C1187,71 1202,76 1204,94
         C1206,114 1198,132 1208,150 C1215,163 1232,162 1236,146 C1241,124 1230,100 1242,86
         C1252,74 1268,82 1264,102 C1260,124 1252,144 1264,164 C1272,178 1290,178 1294,160
         C1300,136 1290,110 1304,96 C1314,86 1328,94 1324,114 C1320,136 1314,158 1326,178
         C1334,191 1352,190 1358,172 L1372,230 Z"
    ></path>
    <path
      d="M320,230 L326,196 C314,188 308,172 314,158 C319,147 331,150 332,162
         C333,175 328,187 336,198 L342,230 Z"
    ></path>
    <path
      d="M980,230 L986,190 C972,180 966,160 974,146 C980,135 993,139 994,153
         C995,168 989,182 998,194 L1004,230 Z"
    ></path>
  </svg>

  <svg class="ds-kelp left" viewBox="0 0 120 560" preserveAspectRatio="none">
    <path d="M40,560 C24,470 56,404 42,318 C30,244 62,186 48,104 C42,68 52,36 46,0"></path>
    <path d="M86,560 C74,486 96,428 84,356 C74,294 94,246 86,186"></path>
  </svg>
  <svg class="ds-kelp right" viewBox="0 0 120 560" preserveAspectRatio="none">
    <path d="M74,560 C90,478 60,412 76,332 C88,262 58,200 72,122 C78,86 68,44 74,0"></path>
    <path d="M28,560 C40,492 18,436 30,368 C40,308 22,258 30,198"></path>
  </svg>

  <!-- 側軌：所有「亮的移動物」都鎖在 chrome 外側的留白帶內 -->
  <span class="ds-rail l">
    {
      BUBBLES.map((b) => (
        <span
          class:list={['ds-bub', b.teal && 'teal']}
          style={`top:${b.t}%;left:${18 + (b.s % 5) * 9}%;width:${b.s}px;height:${b.s}px`}
        />
      ))
    }
    {
      SNOW.map((t, i) => (
        <span
          class="ds-snow"
          style={`top:${t}%;left:${24 + ((i * 13) % 52)}%;width:${2 + (i % 2)}px;height:${2 + (i % 2)}px`}
        />
      ))
    }
    <span class="ds-vent v1">
      {[5, 3, 6, 4, 3, 5, 4].map((s) => <i style={`width:${s}px;height:${s}px`} />)}
    </span>
    <span class="ds-dot" style="top:63%;left:52%;width:3px;height:3px"></span>
    <span class="ds-dot" style="top:79%;left:30%;width:2px;height:2px"></span>
  </span>

  <span class="ds-rail r">
    {
      BUBBLES_R.map((b) => (
        <span
          class:list={['ds-bub', b.teal && 'teal']}
          style={`top:${b.t}%;right:${16 + (b.s % 5) * 10}%;width:${b.s}px;height:${b.s}px`}
        />
      ))
    }
    {
      SNOW.map((t, i) => (
        <span
          class="ds-snow"
          style={`top:${(t + 7) % 100}%;right:${20 + ((i * 17) % 56)}%;width:${2 + ((i + 1) % 2)}px;height:${2 + ((i + 1) % 2)}px`}
        />
      ))
    }
    <span class="ds-vent v2">
      {[6, 4, 3, 5, 4, 3].map((s) => <i style={`width:${s}px;height:${s}px`} />)}
    </span>
    <span class="ds-dot" style="top:67%;right:44%;width:3px;height:3px"></span>
    <span class="ds-dot" style="top:86%;right:24%;width:2px;height:2px"></span>
  </span>

  <!-- 全幅微粒：唯一允許進入閱讀柱後方的環境元素，強度由 --env-mote-op 鎖死 -->
  {MOTES.map(([l, t]) => <span class="ds-mote" style={`left:${l}%;top:${t}%`} />)}
</div>

<style>
  .ds-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .ds-depth {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 88% 28% at 24% -4%,
        color-mix(in oklab, var(--env-raised) 58%, transparent) 0%,
        color-mix(in oklab, var(--env-surface) 18%, transparent) 48%,
        transparent 78%
      ),
      radial-gradient(
        ellipse 54% 38% at 96% 27%,
        color-mix(in oklab, var(--env-surface) 30%, transparent) 0%,
        transparent 74%
      ),
      radial-gradient(
        ellipse 66% 36% at 5% 65%,
        color-mix(in oklab, var(--env-deep) 28%, transparent) 0%,
        transparent 76%
      ),
      linear-gradient(
        to bottom,
        var(--env-surface) 0%,
        var(--env-surface) 8%,
        var(--env-mid) 26%,
        var(--env-deep) 55%,
        var(--env-abyss) 88%,
        var(--env-abyss) 100%
      );
  }

  /* 暗角綁死在 chrome 外側 —— 用百分比會隨視窗寬度漫進閱讀欄 */
  .ds-vignette {
    position: absolute;
    inset: 0;
    --vig: calc((100% - var(--chrome)) / 2);
  }

  .ds-vignette::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, var(--env-abyss) 0%, transparent var(--vig)),
      linear-gradient(to left, var(--env-abyss) 0%, transparent var(--vig)),
      linear-gradient(to top, var(--env-abyss) 0%, transparent 22%);
  }

  .ds-grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: var(--env-abyss);
    opacity: 0.035;
    mix-blend-mode: var(--env-grain-blend);
    -webkit-mask-image: url('/images/grain-mask.svg');
    mask-image: url('/images/grain-mask.svg');
    -webkit-mask-size: 128px 128px;
    mask-size: 128px 128px;
    -webkit-mask-repeat: repeat;
    mask-repeat: repeat;
  }

  .ds-strata {
    position: absolute;
    left: 0;
    right: 0;
    width: 100%;
  }
  .ds-strata.s1 {
    top: 540px;
    height: 420px;
  }
  .ds-strata.s2 {
    top: 1330px;
    height: 300px;
  }
  .ds-strata path {
    fill: var(--env-surface);
    opacity: var(--env-strata-op);
    filter: url(#ds-deckle-f);
  }
  .ds-strata.s2 path {
    fill: var(--env-mid);
    opacity: calc(var(--env-strata-op) * 0.68);
  }

  .ds-caustics {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 460px;
    background:
      radial-gradient(
        ellipse 34% 92% at 10% -18%,
        color-mix(in oklab, var(--env-caustic) 10%, transparent),
        transparent 72%
      ),
      radial-gradient(
        ellipse 24% 74% at 64% -10%,
        color-mix(in oklab, var(--env-caustic) 7%, transparent),
        transparent 76%
      ),
      radial-gradient(
        ellipse 18% 66% at 92% -14%,
        color-mix(in oklab, var(--env-caustic) 5%, transparent),
        transparent 78%
      );
    -webkit-mask-image: linear-gradient(to bottom, var(--fg) 0, transparent 100%);
    mask-image: linear-gradient(to bottom, var(--fg) 0, transparent 100%);
    animation: ds-caustic 46s ease-in-out infinite alternate;
  }

  .ds-beam {
    position: absolute;
    top: -90px;
    width: clamp(280px, 28vw, 440px);
    height: 900px;
    transform: rotate(-14deg);
    transform-origin: top center;
    background: radial-gradient(
      ellipse 46% 100% at 38% 0%,
      color-mix(in oklab, var(--env-beam) 18%, transparent) 0%,
      color-mix(in oklab, var(--env-beam) 7%, transparent) 42%,
      transparent 76%
    );
    clip-path: polygon(18% 0, 56% 0, 100% 100%, 0 100%);
    -webkit-mask-image: linear-gradient(to bottom, var(--fg) 0 18%, transparent 88%);
    mask-image: linear-gradient(to bottom, var(--fg) 0 18%, transparent 88%);
    animation: ds-breathe 34s ease-in-out infinite;
  }
  .ds-beam.b1 {
    left: 40px;
  }
  .ds-beam.b2 {
    display: none;
  }

  .ds-ember-beacon {
    position: absolute;
    z-index: 1;
    top: 180px;
    right: max(32px, calc((100% - var(--chrome)) / 2 + 22px));
    width: 2px;
    height: 180px;
    background: color-mix(in oklab, var(--ember) 18%, transparent);
  }

  .ds-ember-beacon::before {
    content: '';
    position: absolute;
    left: -3px;
    top: -3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ember);
  }

  .ds-compass-mark {
    position: absolute;
    top: 164px;
    left: max(24px, calc((100% - var(--chrome)) / 2 - 84px));
    width: 58px;
    height: 58px;
    color: var(--rule);
    opacity: 0.38;
  }

  .ds-compass-mark circle,
  .ds-compass-mark path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
  }

  /* 有機剪影 —— 強度兩主題不同（結構性不對稱，見 DESIGN.md） */
  .ds-reef {
    position: absolute;
    left: -5%;
    bottom: -88px;
    width: 110%;
    height: 260px;
    opacity: var(--env-organic-op);
  }
  .ds-reef path {
    fill: var(--env-silhouette);
  }

  .ds-kelp {
    position: absolute;
    bottom: -118px;
    height: 560px;
    width: 120px;
    opacity: var(--env-organic-op);
    transform-origin: bottom center;
    animation: ds-sway 44s ease-in-out infinite;
  }
  .ds-kelp.left {
    left: -38px;
    rotate: -5deg;
  }
  .ds-kelp.right {
    right: -46px;
    rotate: 7deg;
    animation-duration: 52s;
    animation-delay: -21s;
  }
  .ds-kelp path {
    fill: none;
    stroke: var(--env-silhouette);
    stroke-width: 9;
    stroke-linecap: round;
  }

  .ds-school {
    position: absolute;
    left: 0;
    fill: var(--env-silhouette);
    opacity: calc(0.62 * var(--env-organic-op));
  }
  .ds-school.sc1 {
    top: 690px;
    width: 210px;
    height: 64px;
    animation: ds-swim-r 128s linear infinite;
  }
  .ds-school.sc2 {
    top: 1180px;
    width: 300px;
    height: 96px;
    opacity: calc(0.5 * var(--env-organic-op));
    animation: ds-swim-l 186s linear infinite -60s;
  }
  .ds-school.sc3 {
    top: 1620px;
    width: 150px;
    height: 46px;
    opacity: calc(0.7 * var(--env-organic-op));
    animation: ds-swim-r 154s linear infinite -95s;
  }

  .ds-jelly {
    position: absolute;
    width: 66px;
    height: 130px;
    animation: ds-pulse 31s ease-in-out infinite;
  }
  .ds-jelly svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .ds-jelly.j1 {
    left: -48px;
    top: 610px;
    width: 104px;
    height: 198px;
  }
  .ds-jelly.j2 {
    right: 210px;
    top: 1460px;
    width: 46px;
    height: 92px;
    animation-duration: 43s;
    animation-delay: -6s;
  }
  .ds-jelly .bell {
    fill: var(--env-silhouette);
    opacity: calc(0.72 * var(--env-organic-op));
  }
  .ds-jelly .tendril {
    fill: none;
    stroke: var(--env-silhouette);
    stroke-width: 2;
    opacity: calc(0.6 * var(--env-organic-op));
  }

  .ds-sea-fan,
  .ds-hydroid {
    position: absolute;
    color: var(--env-silhouette);
    opacity: var(--env-organic-op);
  }

  .ds-sea-fan {
    right: -82px;
    bottom: 22px;
    width: 260px;
    height: 330px;
    transform: rotate(-7deg);
  }

  .ds-hydroid {
    left: -54px;
    top: 58%;
    width: 180px;
    height: 250px;
    transform: rotate(9deg);
  }

  .ds-sea-fan path,
  .ds-hydroid path {
    fill: none;
    stroke: currentColor;
    stroke-width: 5;
    stroke-linecap: round;
  }

  :global([data-theme='tide-light']) .ds-reef,
  :global([data-theme='tide-light']) .ds-kelp,
  :global([data-theme='tide-light']) .ds-sea-fan,
  :global([data-theme='tide-light']) .ds-hydroid {
    opacity: 0.22;
  }

  :global([data-theme='tide-light']) .ds-reef {
    display: none;
  }

  /* 側軌 —— chrome 外側的留白帶。所有亮的移動物只能住在這裡。 */
  .ds-rail {
    position: absolute;
    top: 0;
    bottom: 0;
    width: calc((100% - var(--chrome)) / 2 + var(--gutter-col));
  }
  .ds-rail.l {
    left: 0;
  }
  .ds-rail.r {
    right: 0;
  }

  .ds-bub {
    --bubble-peak: 0.56;
    position: absolute;
    border: 1px solid var(--fg-faint);
    border-radius: 50%;
