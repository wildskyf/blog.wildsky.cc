<script>
  const supportsIndividualTranslate = CSS.supports('translate', '0 1px');
  const parallaxLayers = [
    ['.ds-caustics', -0.012, 0.08, 12, 90],
    ['.ds-beam', 0.025, 0.15, 24, 170],
    ['.ds-strata.s1', -0.02, 0.24, 18, 250],
    ['.ds-strata.s2', 0.025, 0.34, 26, 350],
    ['.ds-school', 0, 0.22, 0, 230],
    ['.ds-jelly', -0.018, 0.38, 18, 380],
    ['.ds-sea-fan, .ds-hydroid', 0.026, 0.4, 28, 400],
    ['.ds-reef, .ds-kelp', -0.03, 0.42, 30, 190],
  ].flatMap(([selector, speedX, speedY, maxX, maxY]) =>
    [...document.querySelectorAll<HTMLElement>(selector as string)].map((element) => ({
      element,
      speedX: speedX as number,
      speedY: speedY as number,
      maxX: maxX as number,
      maxY: maxY as number,
    }))
  );
  let parallaxFrame = 0;
  let parallaxSettleTimer = 0;

  const renderParallax = () => {
    parallaxFrame = 0;
    const isMobile = window.innerWidth < 768;
    const motionScale = isMobile ? 0.9 : 1;
    const scrollDepth = window.scrollY;

    parallaxLayers.forEach(({ element, speedX, speedY, maxX, maxY }) => {
      const offsetX =
        supportsIndividualTranslate && !isMobile
          ? Math.max(-maxX, Math.min(maxX, scrollDepth * speedX * motionScale))
          : 0;
      const offsetY = supportsIndividualTranslate
        ? Math.min(maxY, scrollDepth * speedY * motionScale)
        : 0;
      element.style.translate = `${offsetX.toFixed(2)}px ${offsetY.toFixed(2)}px`;
    });
  };

  const queueParallax = () => {
    if (!parallaxFrame) parallaxFrame = window.requestAnimationFrame(renderParallax);
    if (!supportsIndividualTranslate) return;

    parallaxLayers.forEach(({ element }) => {
      element.style.willChange = 'translate';
    });
    window.clearTimeout(parallaxSettleTimer);
    parallaxSettleTimer = window.setTimeout(() => {
      parallaxLayers.forEach(({ element }) => {
        element.style.willChange = '';
      });
    }, 180);
  };

  window.addEventListener('scroll', queueParallax, { passive: true });
  window.addEventListener('resize', queueParallax);
  queueParallax();
</script>
