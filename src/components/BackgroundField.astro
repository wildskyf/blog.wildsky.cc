---
// 環境層 —— 一道會隨閱讀下沉的水柱（DESIGN.md「Environment」，v9 canon）。
//   * 水色由上往下變暗；捲動時 --depth 由 0 → 1，整道水再沉一階。
//   * 越深：光柱、微塵淡出；生物螢光、水母變亮；過半之後遠方的巨影才浮現。
//   * 這一層允許從閱讀柱後方經過（產品決策 2026-11-02）；可讀性由 token 對比與低不透明度保證。
//   * 刻意不讀 prefers-reduced-motion（產品決策 2026-11-02）。
---

<div class="ds-sea" aria-hidden="true"></div>
<div class="ds-rays" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
<canvas class="ds-fish" aria-hidden="true"></canvas>
<div class="ds-fog" aria-hidden="true"><i></i><i></i></div>
<div class="ds-levi" aria-hidden="true">
  <svg viewBox="0 0 760 220"
    ><path
      d="M760,104 C700,70 610,52 520,58 C430,64 360,86 280,96 C210,104 150,98 96,110 C70,116 40,132 0,128 C38,118 62,104 80,96 C52,84 26,64 6,40 C44,58 82,72 118,80 C170,70 222,60 286,52 C300,30 326,10 360,2 C352,22 350,38 356,50 C420,44 490,40 560,48 C640,56 712,78 760,104 Z M430,92 C450,128 448,170 420,214 C440,176 438,136 410,98 Z M560,90 C590,120 600,160 586,200 C584,164 570,128 540,96 Z"
    ></path></svg
  >
</div>
<canvas class="ds-jellies" aria-hidden="true"></canvas>
<div class="ds-lantern" aria-hidden="true"></div>
<canvas class="ds-snow" aria-hidden="true"></canvas>
<div class="ds-floor" aria-hidden="true">
  <svg viewBox="0 0 1440 300" preserveAspectRatio="xMidYMax slice">
    <path
      class="far"
      d="M0,300 L0,256 Q40,240 80,248 Q120,240 160,252 Q200,238 240,246 Q280,238 320,246 Q360,238 400,260 Q440,252 480,262 Q520,232 560,240 Q600,232 640,255 Q680,247 720,256 Q760,228 800,236 Q840,228 880,250 Q920,232 960,240 Q1000,232 1040,250 Q1080,238 1120,245 Q1160,238 1200,258 Q1240,238 1280,245 Q1320,232 1360,239 Q1400,232 1440,248 L1440,300 Z M0,300 L0,268 L35,268 C57,241 70,186 76,118 C83,193 84,246 105,268 L202,268 C220,234 222,164 226,78 C232,173 241,240 258,268 L590,268 C603,252 610,218 613,178 C617,223 618,254 630,268 L1078,268 C1098,237 1099,174 1104,98 C1110,183 1123,242 1142,268 L1268,268 C1282,246 1290,202 1294,148 C1298,208 1299,250 1312,268 L1440,268 L1440,300 Z"
    ></path>
    <path
      class="near"
      d="M0,300 L0,280 Q40,275 80,281 Q120,277 160,284 Q200,270 240,274 Q280,270 320,286 Q360,275 400,279 Q440,269 480,273 Q520,269 560,285 Q600,274 640,278 Q680,273 720,277 Q760,273 800,285 Q840,276 880,281 Q920,272 960,276 Q1000,272 1040,280 Q1080,272 1120,276 Q1160,272 1200,284 Q1240,278 1280,283 Q1320,278 1360,284 Q1400,275 1440,279 L1440,300 Z M0,300 L0,290 L-9,290 C20,249 37,164 44,60 C53,175 54,256 81,290 L102,290 C114,270 114,230 117,180 C121,235 127,274 138,290 L1192,290 C1218,247 1219,158 1225,50 C1233,170 1248,254 1272,290 L1344,290 C1361,263 1371,208 1375,140 C1380,215 1380,268 1396,290 L1440,290 L1440,300 Z"
    ></path>
  </svg>
</div>
<div class="ds-grain" aria-hidden="true"></div>
<div class="ds-progress" aria-hidden="true"></div>
<div class="ds-gauge" aria-hidden="true">
  <span>DEPTH</span>
  <div class="ds-gauge-track"><div class="ds-gauge-fill"></div></div>
  <span class="ds-gauge-val">000 m</span>
</div>

<style is:global>
  /* ---------- the water column ---------- */
  .ds-sea {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    /* lvh: the toolbar-collapsed height; it does not change while mobile Safari's toolbar slides */
    height: 100vh;
    height: 100lvh;
    z-index: -4;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      var(--water-1) 0%,
      var(--water-2) 30%,
      var(--water-3) 62%,
      var(--water-4) 100%
    );
  }
  /* Sinking: the deeper you read, the darker the water */
  .ds-sea::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--water-4);
    opacity: calc(var(--depth) * 0.5);
  }

  .ds-rays {
    position: fixed;
    top: -10vh;
    top: -10lvh;
    left: -20%;
    right: -20%;
    height: 110vh;
    height: 110lvh;
    z-index: -3;
    pointer-events: none;
    opacity: calc(1 - var(--depth) * 0.9);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, rgb(0 0 0 / 0.6) 40%, transparent 85%);
    mask-image: linear-gradient(180deg, #000 0%, rgb(0 0 0 / 0.6) 40%, transparent 85%);
  }
  .ds-rays i {
    position: absolute;
    top: -10%;
    height: 120%;
    transform-origin: top center;
    background: linear-gradient(180deg, var(--env-ray), transparent 90%);
    filter: blur(14px);
    animation: ds-sway 18s ease-in-out infinite alternate;
  }
  .ds-rays i:nth-child(1) {
    left: 22%;
    width: 120px;
    transform: rotate(16deg);
    animation-duration: 21s;
  }
  .ds-rays i:nth-child(2) {
    left: 38%;
    width: 60px;
    transform: rotate(13deg);
    animation-duration: 17s;
    animation-delay: -6s;
  }
  .ds-rays i:nth-child(3) {
    left: 52%;
    width: 180px;
    transform: rotate(18deg);
    animation-duration: 24s;
    animation-delay: -3s;
  }
  .ds-rays i:nth-child(4) {
    left: 70%;
    width: 80px;
    transform: rotate(14deg);
    animation-duration: 19s;
    animation-delay: -9s;
  }
  .ds-rays i:nth-child(5) {
    left: 84%;
    width: 140px;
    transform: rotate(17deg);
    animation-duration: 26s;
  }
  /* MotionToggle: freeze the CSS layers where they are */
  html[data-motion='paused'] :is(.ds-rays i, .ds-fog i, .ds-levi svg) {
    animation-play-state: paused;
  }
  @keyframes ds-sway {
    from {
      translate: -24px 0;
      opacity: 0.55;
    }
    to {
      translate: 24px 0;
      opacity: 1;
    }
  }

  .ds-fish,
  .ds-jellies,
  .ds-snow {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    /* lvh: the toolbar-collapsed height; it does not change while mobile Safari's toolbar slides */
    height: 100vh;
    height: 100lvh;
    pointer-events: none;
  }
  .ds-fish {
    z-index: -3;
  } /* far: behind the mist */
  .ds-jellies {
    z-index: -1;
  } /* near: in front of it */
  .ds-snow {
    z-index: -1;
  }

  /* 夕霧: two banks of mist; the upper one warmed by lamplight, the lower one cold.
     Filter matrices live here, not in tokens: they are noise coefficients, not UI colour. */
  .ds-fog {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    /* lvh: the toolbar-collapsed height; it does not change while mobile Safari's toolbar slides */
    height: 100vh;
    height: 100lvh;
    z-index: -2;
    pointer-events: none;
    overflow: hidden;
    opacity: var(--env-fog-op);
  }
  .ds-fog i {
    position: absolute;
    left: 0;
    will-change: transform;
    filter: blur(4px);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 35%, #000 65%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 35%, #000 65%, transparent);
  }
  .ds-fog i:nth-child(1) {
    top: 4%;
    height: 46%;
    width: calc(100% + 1400px);
    background-size: 1400px 100%;
    animation: ds-fog-a 110s linear infinite;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1400' height='500' preserveAspectRatio='none'><filter id='f' x='0' y='0' width='100%' height='100%'><feTurbulence type='fractalNoise' baseFrequency='.0035714 .012' numOctaves='4' seed='7' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .86 0 0 0 0 .83 0 0 0 0 .74 1.9 0 0 0 -.62'/></filter><rect width='100%' height='100%' filter='url(%23f)'/></svg>");
  }
  .ds-fog i:nth-child(2) {
    top: 48%;
    height: 50%;
    width: calc(100% + 1800px);
    left: -1800px;
    background-size: 1800px 100%;
    animation: ds-fog-b 160s linear infinite;
    opacity: 0.8;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1800' height='600' preserveAspectRatio='none'><filter id='f' x='0' y='0' width='100%' height='100%'><feTurbulence type='fractalNoise' baseFrequency='.0027778 .01' numOctaves='4' seed='21' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .72 0 0 0 0 .82 0 0 0 0 .86 1.9 0 0 0 -.64'/></filter><rect width='100%' height='100%' filter='url(%23f)'/></svg>");
  }
  @keyframes ds-fog-a {
    to {
      transform: translateX(-1400px);
    }
  }
  @keyframes ds-fog-b {
    to {
      transform: translateX(1800px);
    }
  }

  /* The far shadow: surfaces only past the halfway point */
  .ds-levi {
    position: fixed;
    left: 0;
    top: 30vh;
    top: 30lvh;
    z-index: -2;
    width: 100vw;
    height: 260px;
    pointer-events: none;
    overflow: hidden;
    opacity: calc(clamp(0, (var(--depth) - 0.4) * 2.2, 1) * 0.6);
    transition: opacity 0.6s;
  }
  .ds-levi svg {
    position: absolute;
    top: 0;
    width: 760px;
    height: 220px;
    fill: var(--env-sil);
    filter: blur(4px);
    animation: ds-levi 240s linear infinite;
  }
  @keyframes ds-levi {
    from {
      transform: translateX(calc(100vw + 60px)) rotate(-2deg);
    }
    to {
      transform: translateX(-820px) rotate(2deg);
    }
  }

  .ds-lantern {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    /* lvh: the toolbar-collapsed height; it does not change while mobile Safari's toolbar slides */
    height: 100vh;
    height: 100lvh;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s;
    background: radial-gradient(
      circle 240px at var(--mx, 50%) var(--my, 40%),
      var(--env-lantern),
      transparent 70%
    );
  }
  html.has-pointer .ds-lantern {
    opacity: 1;
  }

  /* Sea floor: stone needles rising out of the murk, behind the mist */
  .ds-floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: -3;
    height: 300px;
    pointer-events: none;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, rgb(0 0 0 / 0.35) 35%, #000 85%);
    mask-image: linear-gradient(180deg, transparent 0%, rgb(0 0 0 / 0.35) 35%, #000 85%);
  }
  .ds-floor svg {
    position: absolute;
    bottom: 0;
    left: -2%;
    width: 104%;
    height: 100%;
  }
  .ds-floor .far {
    fill: var(--env-sil-far);
    opacity: 0.55;
    filter: blur(3px);
  }
  .ds-floor .near {
    fill: var(--env-sil-near);
    opacity: 0.8;
    filter: blur(0.6px);
  }

  /* Rock / ink grain over everything */
  .ds-grain {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    /* lvh: the toolbar-collapsed height; it does not change while mobile Safari's toolbar slides */
    height: 100vh;
    height: 100lvh;
    z-index: 30;
    pointer-events: none;
    opacity: var(--env-grain-op);
    mix-blend-mode: var(--env-grain-blend);
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .5 0 0 0 0 .5 0 0 0 0 .5 0 0 0 1.1 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }

  /* ---------- reading progress + depth gauge ---------- */
  .ds-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    height: 2px;
    width: calc(var(--depth) * 100%);
    background: linear-gradient(90deg, transparent, var(--glow) 40%, var(--fg));
  }

  .ds-gauge {
    position: fixed;
    right: 32px;
    top: 50%;
    z-index: 10;
    display: none;
    flex-direction: column;
    align-items: end;
    gap: 10px;
    transform: translateY(-50%);
    font: 400 10px/1 var(--font-meta);
    letter-spacing: 0.12em;
    color: var(--fg-faint);
    pointer-events: none;
  }
  html.is-reading .ds-gauge {
    display: flex;
  }
  .ds-gauge-track {
    position: relative;
    width: 1px;
    height: 200px;
    background: var(--rule-strong);
  }
  .ds-gauge-track::before,
  .ds-gauge-track::after {
    content: '';
    position: absolute;
    left: -3px;
    width: 7px;
    height: 1px;
    background: var(--rule-strong);
  }
  .ds-gauge-track::before {
    top: 0;
  }
  .ds-gauge-track::after {
    bottom: 0;
  }
  .ds-gauge-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: calc(var(--depth) * 100%);
    background: linear-gradient(180deg, var(--fg), var(--glow));
  }
  .ds-gauge-fill::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: -3px;
    width: 7px;
    height: 7px;
    background: var(--glow);
    transform: rotate(45deg);
    box-shadow: 0 0 8px var(--glow);
  }
  .ds-gauge-val {
    color: var(--fg-muted);
  }

  @media (max-width: 1279px) {
    html.is-reading .ds-gauge {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .ds-floor {
      height: 180px;
    }
  }
</style>

<script>
  const root = document.documentElement;
  root.classList.toggle('is-reading', !!document.querySelector('.ds-article'));

  // Mobile Safari changes innerHeight every time its toolbar slides in or out. Every size
  // decision below reads the large-viewport height (.ds-sea is 100lvh) instead, so the
  // scene stays put while scrolling.
  const seaEl = document.querySelector<HTMLElement>('.ds-sea');
  const stableH = () => seaEl?.clientHeight || innerHeight;

  // ---------- depth: one passive scroll listener writes --depth ----------
  const gaugeVal = document.querySelector<HTMLElement>('.ds-gauge-val');
  let depthFrame = 0;
  let depth = 0;
  const writeDepth = () => {
    depthFrame = 0;
    const max = document.documentElement.scrollHeight - stableH();
    const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
    depth = p;
    root.style.setProperty('--depth', p.toFixed(3));
    if (gaugeVal) gaugeVal.textContent = String(Math.round(p * 200)).padStart(3, '0') + ' m';
  };
  const queueDepth = () => {
    if (!depthFrame) depthFrame = requestAnimationFrame(writeDepth);
  };
  addEventListener('scroll', queueDepth, { passive: true });
  addEventListener('resize', queueDepth);
  writeDepth();

  // ---------- pointer: lantern + a gentle current in the particles ----------
  const ptr = { x: -9999, y: -9999, on: false };
  if (matchMedia('(pointer: fine)').matches) {
    addEventListener(
      'pointermove',
      (e) => {
        ptr.x = e.clientX;
        ptr.y = e.clientY;
        ptr.on = true;
        root.style.setProperty('--mx', e.clientX + 'px');
        root.style.setProperty('--my', e.clientY + 'px');
        root.classList.add('has-pointer');
      },
      { passive: true }
    );
    document.addEventListener('pointerleave', () => {
      ptr.on = false;
      root.classList.remove('has-pointer');
    });
  }

  const rnd = (a: number, b: number) => a + Math.random() * (b - a);
  // Theme tokens for the canvases; read once per theme switch, not every frame
  const env = { snow: '', dust: '', lumen: '', fish: '', fishA: 0.5 };
  const readEnv = () => {
    const cs = getComputedStyle(root);
    env.snow = cs.getPropertyValue('--env-snow').trim();
    env.dust = cs.getPropertyValue('--env-dust').trim();
    env.lumen = cs.getPropertyValue('--env-lumen').trim();
    env.fish = cs.getPropertyValue('--env-fish').trim();
    env.fishA = parseFloat(cs.getPropertyValue('--env-fish-a')) || 0.5;
  };
  readEnv();
  const setup = (c: HTMLCanvasElement, W: number, H: number, dpr: number) => {
    c.width = W * dpr;
    c.height = H * dpr;
    c.style.width = W + 'px';
    c.style.height = H + 'px';
    const x = c.getContext('2d')!;
    x.setTransform(dpr, 0, 0, dpr, 0, 0);
    return x;
  };
  // Push particles away from the pointer (k > 0) or draw them in (k < 0); returns closeness 0..1
  const push = (p: { x: number; y: number }, k: number) => {
    if (!ptr.on) return 0;
    const dx = p.x - ptr.x;
    const dy = p.y - ptr.y;
    const d2 = dx * dx + dy * dy;
    if (d2 > 160 * 160) return 0;
    const d = Math.sqrt(d2) || 1;
    const f = 1 - d / 160;
    p.x += (dx / d) * f * k;
    p.y += (dy / d) * f * k;
    return f;
  };

  // ---------- particles: marine snow, dust lit only inside the shafts, bioluminescence ----------
  type Snow = {
    x: number;
    y: number;
    r: number;
    vy: number;
    ph: number;
    a: number;
    glint: boolean;
  };
  type Dust = { x: number; y: number; r: number; vx: number; vy: number; ph: number };
  type Lumen = { x: number; y: number; r: number; ph: number; sp: number; dir: number };
  // Mirror of the CSS rays: left fraction, width px, angle deg (container is inset -10% -20%)
  const RAYS: [number, number, number][] = [
    [0.22, 120, 16],
    [0.38, 60, 13],
    [0.52, 180, 18],
    [0.7, 80, 14],
    [0.84, 140, 17],
  ];

  // ---------- creatures ----------
  type Fish = { ox: number; oy: number; s: number; ph: number; wag: number };
  type School = {
    dir: number;
    pageY: number;
    par: number;
    fish: Fish[];
    x: number;
    v: number;
    ph: number;
  };
  type Jelly = {
    xf: number;
    pageY: number;
    par: number;
    w: number;
    x: number;
    oy: number;
    vy: number;
    T: number;
    ph: number;
    tp: number;
    tl: number[];
  };

  const snowC = document.querySelector<HTMLCanvasElement>('.ds-snow')!;
  const fishC = document.querySelector<HTMLCanvasElement>('.ds-fish')!;
  const jellyC = document.querySelector<HTMLCanvasElement>('.ds-jellies')!;
  let W = 0;
  let H = 0;
  let sx: CanvasRenderingContext2D;
  let fx: CanvasRenderingContext2D;
  let jx: CanvasRenderingContext2D;
  let snow: Snow[] = [];
  let dust: Dust[] = [];
  let lumen: Lumen[] = [];
  let schools: School[] = [];
  let jellies: Jelly[] = [];

  const makeSchool = (
    dir: number,
    pageY: number,
    par: number,
    n: number,
    scale: number
  ): School => ({
    dir,
    pageY,
    par,
    fish: Array.from({ length: n }, () => ({
      ox: rnd(-90, 90),
      oy: rnd(-26, 26),
      s: rnd(0.75, 1.15) * scale,
      ph: rnd(0, 6.28),
      wag: rnd(0.9, 1.2),
    })),
    x: dir > 0 ? rnd(-200, W * 0.4) : rnd(W * 0.6, W + 200),
    v: rnd(0.32, 0.45),
    ph: rnd(0, 6.28),
  });
  const makeJelly = (xf: number, pageY: number, par: number, w: number): Jelly => ({
    xf,
    pageY,
    par,
    w,
    x: xf * W,
    oy: 0,
    vy: 0,
    T: rnd(3600, 5200),
    ph: rnd(0, 5000),
    tp: rnd(0, 6.28),
    tl: Array.from({ length: 8 }, () => rnd(3.2, 4.6)),
  });

  const size = () => {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const nextW = innerWidth;
    const nextH = stableH();
    if (nextW === W && nextH === H) return;
    const widthChanged = nextW !== W;
    W = nextW;
    H = nextH;
    sx = setup(snowC, W, H, dpr);
    fx = setup(fishC, W, H, dpr);
    jx = setup(jellyC, W, H, dpr);
    // Only a real width change (rotation, window resize) re-seeds the creatures;
    // re-seeding on every height change is what made fish and jellies jump on iOS.
    if (!widthChanged) return;
    const area = W * H;
    snow = Array.from({ length: Math.round(Math.min(70, area / 22000)) }, () => ({
      x: rnd(0, W),
      y: rnd(0, H),
      r: rnd(0.3, 1.7),
      vy: -rnd(0.04, 0.22),
      ph: rnd(0, 6.28),
      a: rnd(0.08, 0.43),
      glint: Math.random() < 0.12,
    }));
    dust = Array.from({ length: Math.round(Math.min(220, area / 6000)) }, () => ({
      x: rnd(0, W),
      y: rnd(0, H * 0.8),
      r: rnd(0.35, 1.1),
      vx: rnd(-0.06, 0.06),
      vy: rnd(-0.05, 0.05),
      ph: rnd(0, 6.28),
    }));
    lumen = Array.from({ length: Math.round(Math.min(14, area / 90000)) + 3 }, () => ({
      x: rnd(0, W),
      y: rnd(0, H),
      r: rnd(1.4, 2.6),
      ph: rnd(0, 6.28),
      sp: rnd(0.6, 1.4),
      dir: rnd(0, 6.28),
    }));
    schools = [
      makeSchool(1, 520, 0.32, 11, 1.25),
      makeSchool(-1, 1150, 0.24, 8, 1),
      makeSchool(1, 1900, 0.2, 6, 0.8),
    ];
    // Jellies live in the side gutters; none where the gutters are too narrow
    jellies =
      W < 900
        ? []
        : [
            makeJelly(0.06, 620, 0.55, 22),
            makeJelly(0.935, 1250, 0.7, 14),
            makeJelly(0.9, 2100, 0.45, 10),
          ];
  };

  // Brightness of the light shafts at a point, 0..1
  const shaft = (px: number, py: number) => {
    const cw = W * 1.4;
    const cl = -W * 0.2;
    const top = -H * 0.1;
    let v = 0;
    for (const [l, w, a] of RAYS) {
      const rad = (a * Math.PI) / 180;
      const cx = cl + cw * l + w / 2;
      const d = Math.abs(px - (cx - (py - top) * Math.tan(rad))) * Math.cos(rad);
      v += Math.exp(-(d * d) / (w * w * 0.35));
    }
    return Math.min(1, v) * Math.max(0, 1 - py / (H * 0.85));
  };

  // A fish facing +x, length ~ 22*s, tail angle a
  const drawFish = (x: CanvasRenderingContext2D, s: number, a: number) => {
    const L = 22 * s;
    x.beginPath();
    x.moveTo(L * 0.5, 0);
    x.bezierCurveTo(L * 0.38, -L * 0.2, -L * 0.18, -L * 0.2, -L * 0.32, 0);
    x.bezierCurveTo(-L * 0.18, L * 0.2, L * 0.38, L * 0.2, L * 0.5, 0);
    x.fill();
    x.save();
    x.translate(-L * 0.3, 0);
    x.rotate(a);
    x.beginPath();
    x.moveTo(0, 0);
    x.lineTo(-L * 0.26, -L * 0.17);
    x.lineTo(-L * 0.2, 0);
    x.lineTo(-L * 0.26, L * 0.17);
    x.closePath();
    x.fill();
    x.restore();
  };

  const drawJelly = (
    x: CanvasRenderingContext2D,
    j: Jelly,
    k: number,
    A: number,
    t: number,
    L: string
  ) => {
    const w = j.w;
    const bw = w * (1 - 0.2 * k);
    const bh = w * 0.85 * (1 + 0.16 * k);
    // tentacles first, behind the bell
    const tg = x.createLinearGradient(0, 0, 0, w * 4.6);
    tg.addColorStop(0, `rgba(${L},${(0.2 * A).toFixed(3)})`);
    tg.addColorStop(1, `rgba(${L},0)`);
    x.strokeStyle = tg;
    x.lineWidth = 0.7;
    const slack = 1 - Math.min(1, Math.abs(j.vy) * 1.6); // fast strokes pull the tentacles straight
    for (let i = 0; i < 8; i++) {
      const rx = -bw * 0.85 + (bw * 1.7 * i) / 7;
      const len = w * j.tl[i];
      x.beginPath();
      x.moveTo(rx, bh * 0.04);
      for (let s = 1; s <= 16; s++) {
        const q = s / 16;
        const wave = Math.sin(t / 650 - s * 0.5 + i * 1.7) * (1.5 + 9 * q) * (0.35 + 0.65 * slack);
        x.lineTo(rx * (1 + q * 0.25 * slack) + wave, bh * 0.04 + len * q * (1 - 0.12 * k));
      }
      x.stroke();
    }
    // oral arms
    x.lineWidth = 2;
    x.strokeStyle = `rgba(${L},${(0.07 * A).toFixed(3)})`;
    for (let i = -1; i <= 1; i++) {
      x.beginPath();
      x.moveTo(i * bw * 0.18, 0);
      for (let s = 1; s <= 10; s++)
        x.lineTo(i * bw * 0.18 + Math.sin(t / 500 + s * 0.8 + i) * 2.2, s * w * 0.16);
      x.stroke();
    }
    // bell
    x.beginPath();
    x.moveTo(-bw, 0);
    x.bezierCurveTo(-bw, -bh * 1.3, bw, -bh * 1.3, bw, 0);
    x.quadraticCurveTo(bw * 0.7, bh * 0.14, 0, bh * 0.08);
    x.quadraticCurveTo(-bw * 0.7, bh * 0.14, -bw, 0);
    const g = x.createRadialGradient(0, -bh * 0.55, 0, 0, -bh * 0.4, bw * 1.25);
    g.addColorStop(0, `rgba(${L},${(0.11 * A).toFixed(3)})`);
    g.addColorStop(0.65, `rgba(${L},${(0.04 * A).toFixed(3)})`);
    g.addColorStop(1, `rgba(${L},${(0.015 * A).toFixed(3)})`);
    x.fillStyle = g;
    x.fill();
    x.save();
    x.shadowColor = `rgba(${L},${(0.5 * A).toFixed(3)})`;
    x.shadowBlur = 8;
    x.strokeStyle = `rgba(${L},${(0.24 * A).toFixed(3)})`;
    x.lineWidth = 0.8;
    x.stroke();
    x.restore();
    x.beginPath();
    x.moveTo(-bw * 0.72, -bh * 0.02);
    x.quadraticCurveTo(0, -bh * 0.78, bw * 0.72, -bh * 0.02);
    x.strokeStyle = `rgba(${L},${(0.09 * A).toFixed(3)})`;
    x.lineWidth = 0.7;
    x.stroke();
    x.fillStyle = `rgba(${L},${(0.06 * A).toFixed(3)})`;
    for (const s of [-1, 1]) {
      x.beginPath();
      x.ellipse(s * bw * 0.27, -bh * 0.5, bw * 0.17, bh * 0.11, s * 0.5, 0, 6.283);
      x.fill();
    }
  };

  let last = performance.now();
  const frame = (t: number) => {
    const f = Math.min(3, (t - last) / 16.67);
    last = t;
    const { snow: sRGB, dust: dRGB, lumen: lRGB, fish: F, fishA: FA } = env;

    // particles
    sx.clearRect(0, 0, W, H);
    const fade = 1 - depth * 0.9;
    for (const p of dust) {
      p.x += p.vx + Math.sin(t / 2600 + p.ph) * 0.05;
      p.y += p.vy + Math.cos(t / 3100 + p.ph) * 0.04;
      if (p.x < -4) p.x = W + 4;
      if (p.x > W + 4) p.x = -4;
      if (p.y < -4) p.y = H * 0.8;
      if (p.y > H * 0.85) p.y = 0;
      const lit = shaft(p.x, p.y) * fade + push(p, 0.25) * 0.4;
      if (lit < 0.03) continue;
      sx.beginPath();
      sx.arc(p.x, p.y, p.r, 0, 6.283);
      sx.fillStyle = `rgba(${dRGB},${(lit * 0.75).toFixed(3)})`;
      sx.fill();
    }
    for (const p of snow) {
      p.y += p.vy;
      p.x += Math.sin(t / 3000 + p.ph) * 0.12;
      if (p.y < -5) {
        p.y = H + 5;
        p.x = rnd(0, W);
      }
      const near = push(p, 0.6);
      const tw = p.glint ? 0.5 + 0.5 * Math.sin(t / 900 + p.ph) : 1;
      sx.beginPath();
      sx.arc(p.x, p.y, p.r * (p.glint ? 1.4 : 1), 0, 6.283);
      sx.fillStyle = `rgba(${sRGB},${Math.min(1, p.a * tw + near * 0.35).toFixed(3)})`;
      sx.fill();
    }
    // bioluminescence: few near the surface, more as you sink
    const vis = 0.18 + depth * 0.82;
    sx.save();
    sx.shadowColor = `rgb(${lRGB})`;
    for (const p of lumen) {
      p.dir += Math.sin(t / 4000 + p.ph) * 0.01;
      p.x += Math.cos(p.dir) * 0.12 * p.sp;
      p.y += Math.sin(p.dir) * 0.08 * p.sp - 0.03;
      if (p.x < -10) p.x = W + 10;
      if (p.x > W + 10) p.x = -10;
      if (p.y < -10) p.y = H + 10;
      if (p.y > H + 10) p.y = -10;
      const near = push(p, -0.15); // curious: drifts toward the light
      const breathe = 0.35 + 0.65 * Math.pow(0.5 + 0.5 * Math.sin(t / (1400 * p.sp) + p.ph), 2);
      sx.shadowBlur = 10 + 10 * breathe;
      sx.beginPath();
      sx.arc(p.x, p.y, p.r, 0, 6.283);
      sx.fillStyle = `rgba(${lRGB},${(Math.min(1, vis * breathe + near * 0.4) * 0.9).toFixed(3)})`;
      sx.fill();
    }
    sx.restore();

    // fish schools
    fx.clearRect(0, 0, W, H);
    // While reading, fish keep clear of the text: fully faded within the 720px column,
    // back to full strength ~140px outside it.
    const reading = root.classList.contains('is-reading');
    const colHalf = 380;
    const fishAlpha = (x: number) => {
      if (!reading) return FA;
      const d = Math.abs(x - W / 2) - colHalf;
      return FA * Math.min(1, Math.max(0, d / 140));
    };
    for (const sc of schools) {
      sc.x += sc.v * sc.dir * f;
      if (sc.dir > 0 && sc.x > W + 220) sc.x = -220;
      if (sc.dir < 0 && sc.x < -220) sc.x = W + 220;
      const sy = sc.pageY - scrollY * sc.par + Math.sin(t / 5200 + sc.ph) * 26;
      if (sy < -120 || sy > H + 120) continue;
      const slope = (((Math.cos(t / 5200 + sc.ph) * 26) / 5200) * 16.67) / (sc.v || 1); // heading follows the wave
      for (const fi of sc.fish) {
        const x = sc.x + fi.ox * sc.dir + Math.sin(t / 1300 + fi.ph) * 5;
        const y = sy + fi.oy + Math.cos(t / 1700 + fi.ph) * 4;
        const a = fishAlpha(x);
        if (a < 0.01) continue;
        fx.fillStyle = `rgba(${F},${a.toFixed(3)})`;
        fx.save();
        fx.translate(x, y);
        fx.scale(sc.dir, 1);
        fx.rotate(slope * 0.6);
        drawFish(fx, fi.s, Math.sin((t / 160) * fi.wag + fi.ph) * 0.35);
        fx.restore();
      }
    }

    // jellyfish: squeeze, glide, sink
    jx.clearRect(0, 0, W, H);
    const A = 0.55 + depth * 0.45;
    for (const j of jellies) {
      const ph = ((t + j.ph) % j.T) / j.T;
      const k =
        ph < 0.22 ? Math.sin(((ph / 0.22) * Math.PI) / 2) : Math.pow(1 - (ph - 0.22) / 0.78, 2);
      const tilt = Math.sin(t / 7000 + j.tp) * 0.2;
      const steer = j.oy < -140 ? 0.35 : j.oy > 140 ? 1.5 : 1;
      if (ph < 0.22) j.vy -= 0.014 * steer * f * (j.w / 18);
      j.vy += 0.0045 * f; // negative buoyancy: sinks between strokes
      j.vy *= Math.exp(-f / 50); // water drag
      j.oy += j.vy * f;
      j.x += Math.sin(tilt) * -j.vy * f + (j.xf * W - j.x) * 0.002 * f;
      const y = j.pageY - scrollY * j.par + j.oy;
      if (y < -200 || y > H + 200) continue;
      jx.save();
      jx.translate(j.x, y);
      jx.rotate(tilt);
      drawJelly(jx, j, k, A, t, lRGB);
      jx.restore();
    }
  };

  // ---------- run / pause (MotionToggle sets data-motion="paused" on <html>) ----------
  // While paused the scene is redrawn with time frozen, so scrolling and theme switches
  // still move and recolour it, but nothing moves on its own.
  const paused = () => root.dataset.motion === 'paused';
  let running = false;
  let frozenT = performance.now();
  let stillFrame = 0;
  const loop = (t: number) => {
    if (paused()) {
      running = false;
      frozenT = last;
      return;
    }
    frame(t);
    requestAnimationFrame(loop);
  };
  const start = () => {
    if (running || paused()) return;
    running = true;
    last = performance.now();
    requestAnimationFrame(loop);
  };
  const drawStill = () => {
    if (!paused() || stillFrame) return;
    stillFrame = requestAnimationFrame(() => {
      stillFrame = 0;
      last = frozenT;
      frame(frozenT);
    });
  };
  new MutationObserver(() => {
    readEnv();
    if (paused()) drawStill();
    else start();
  }).observe(root, { attributes: true, attributeFilter: ['data-theme', 'data-motion'] });
  addEventListener('scroll', drawStill, { passive: true });

  let resizeTimer = 0;
  addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      size();
      drawStill();
    }, 150);
  });
  size();
  if (paused()) drawStill();
  else start();
</script>
