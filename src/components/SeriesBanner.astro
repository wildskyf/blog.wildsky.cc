---
const { seriesTitle, seriesUrl } = Astro.props;
---

<aside class="ds-series">
  本文屬於
  <a href={seriesUrl}>{seriesTitle}</a>
  ，可回系列頁查看完整脈絡。
</aside>

<style>
  /* 系列橫幅：透明底 ＋ 僅左側 2px 紅線，上下無框。
     這是紅色作為「線」的標準用法（DESIGN.md「Cards / Containers」）。 */
  .ds-series {
    margin: 0 0 40px;
    padding: 14px 0 14px 18px;
    background: transparent;
    border-left: 2px solid var(--accent);
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.8;
    color: var(--fg-muted);
  }

  .ds-series a {
    color: var(--fg);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition: border-color var(--t) var(--ease);
  }

  .ds-series a:hover {
    border-bottom-color: var(--accent);
  }
</style>
