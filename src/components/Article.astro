---
import dayjs from 'dayjs';
import { twMerge } from 'tailwind-merge'

const {
  feature_image_url,
  feature_image_caption,
  date,
  title,
  lang,
  ...props
} = Astro.props;
const currentLocale = lang || Astro.currentLocale || 'tw';

const publish_time = dayjs(date).format('YYYY 年 MM 月 DD 日');
---

<article
  class={`
    prose prose-xl max-md:prose-lg max-w-none
    bg-base-100 px-6 lg:px-12 mt-0 lg:mt-4 pt-8 pb-16
    ${currentLocale === 'tw' ? 'prose-zh tracking-tw-normal' : 'prose-en'}
  `}
  {...props}
>
  <header class="not-prose mb-8">
    <h1
      class={`
        text-3xl lg:text-4xl font-bold text-base-content mb-4
        ${currentLocale === 'tw' ? 'tracking-tw-normal' : ''}
      `}
      set:html={title}
    />
    {
      date && (
        <p class="text-sm text-base-content/70">
          <time datetime={date}>{publish_time}</time>
        </p>
      )
    }
  </header>

  {feature_image_url && (
    <figure class="flex flex-col mb-8 bg-base-300 p-4 rounded">
      <img
        src={feature_image_url}
        alt={feature_image_caption}
        class="w-full max-w-full h-auto"
        width="750"
        height="410"
        class="rounded-lg"
      />

      {feature_image_url && (
        <figcaption
          class="prose text-center mt-1"
          set:html={feature_image_caption}
        />
      )}
    </figure>
  )}

  <div class={twMerge('article-content', currentLocale === 'tw' && 'tracking-tw-normal')}>
    <slot />
  </div>
</article>
