---
import dayjs from 'dayjs';
import TagList from '@/components/TagList.astro';
import SeriesBanner from '@/components/SeriesBanner.astro';

const {
  feature_image_url,
  feature_image_caption,
  date,
  title,
  lang,
  category,
  tags,
  readingTime,
  readingMinutes,
  series,
  translation,
  headings = [],
} = Astro.props;
const currentLocale = lang || Astro.currentLocale || 'tw';
const root_path = currentLocale === 'en' ? '/en' : '';
const feature_image_alt =
  feature_image_caption
    ?.replace(/<[^>]*>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim() ?? '';

// v9 HUD meta (product decision 2026-11-02)
const publish_time = dayjs(date).format('YYYY.MM.DD');
const minutes = readingMinutes ? `${readingMinutes} MIN` : readingTime;

// Contents for longer pieces. Astro lists the sr-only footnotes heading too; it is not a section.
const sections = headings.filter(
  (h: { depth: number; slug: string }) => h.depth === 2 && h.slug !== 'footnote-label'
);
const showContents = sections.length >= 4;
const contentsOpen = sections.length <= 8;
const contentsLabel = currentLocale === 'en' ? 'Table of contents' : '本文目錄';
const anchorLabel = currentLocale === 'en' ? 'Link to this section:' : '連結到這一節：';
---

<article class="ds-article">
  <header class="ds-article-head">
    <div class="ds-article-kicker">
      {
        category && (
          <a class="ds-chip" href={`${root_path}/categories/${category}`}>
            {category}
          </a>
        )
      }
      {category && minutes && <span class="ds-meta-sep">/</span>}
      {minutes && <span lang="en">{minutes}</span>}
      {
        date && (
          <>
            <span class="ds-meta-sep">/</span>
            <time datetime={new Date(date).toISOString()}>{publish_time}</time>
          </>
        )
      }
    </div>

    <h1 class="ds-article-title" set:html={title} />

    {
      translation && (
        <a
          class="ds-translation-link"
          href={translation.href}
          hreflang={translation.hreflang}
          lang={translation.hreflang}
        >
          {translation.label}
        </a>
      )
    }

    <TagList tags={tags} lang={currentLocale} />
  </header>

  {series && <SeriesBanner seriesTitle={series.name} seriesUrl={series.url} />}

  {
    feature_image_url && (
      <figure class="ds-figure">
        <img src={feature_image_url} alt={feature_image_alt} width="750" height="410" />
        {feature_image_caption && <figcaption set:html={feature_image_caption} />}
      </figure>
    )
  }

  {
    showContents && (
      <nav class="ds-toc" aria-label={contentsLabel}>
        <details open={contentsOpen}>
          <summary>
            <span class="ds-toc-title" lang="en">
              Contents
            </span>
            <span class="ds-toc-count">{sections.length}</span>
            <svg viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" />
            </svg>
          </summary>
          <ol>
            {sections.map((h: { slug: string; text: string }) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      </nav>
    )
  }

  <div
    class="article-content ds-prose"
    lang={currentLocale === 'tw' ? 'zh-Hant-TW' : 'en'}
    data-anchor-label={anchorLabel}
  >
    <slot />
  </div>
</article>

<script>
  // Section links: a "#" in the left gutter of each h2, shown on hover or keyboard focus
  document.querySelectorAll<HTMLElement>('.ds-prose').forEach((prose) => {
    prose.querySelectorAll<HTMLElement>('h2[id]:not(#footnote-label)').forEach((h2) => {
      const a = document.createElement('a');
      a.className = 'ds-anchor';
      a.href = `#${h2.id}`;
      a.textContent = '#';
      a.setAttribute('aria-label', `${prose.dataset.anchorLabel} ${h2.textContent?.trim()}`);
      h2.append(a);
    });
  });
</script>

<style>
  /* Read mode —— The Boring Body Rule。
     正文沒有容器：直接坐在環境層上，720px 置中，無底色差、無邊框。 */
  .ds-article {
    width: min(var(--measure), 100% - var(--page-gutter) * 2);
    margin-inline: auto;
    padding: 100px 0 96px;
  }

  .ds-article-head {
    margin-bottom: 40px;
  }

  .ds-article-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 28px;
    font-family: var(--font-meta);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--fg-faint);
  }

  .ds-article-kicker :global(.ds-meta-sep) {
    color: var(--rule-strong);
  }

  /* The padding grows the target to ~31px tall; the negative margin keeps the line where it was */
  .ds-article-kicker :global(.ds-chip) {
    display: inline-block;
    padding-block: 4px;
    margin-block: -4px;
    color: var(--fg-faint);
    text-decoration: none;
  }
  .ds-article-kicker :global(.ds-chip:hover) {
    color: var(--fg);
  }

  /* Display 級 —— 全站唯一使用 clamp 的字級 */
  .ds-article-title {
    margin: 0 0 24px;
    font-family: var(--font-cjk-display);
    font-size: clamp(32px, 4.4vw, 46px);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.01em;
    text-wrap: balance;
    background: var(--title-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .ds-translation-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    margin: 0 0 20px;
    padding: 8px 14px;
    border: 1px solid var(--rule);
    background: var(--bg-surface);
    color: var(--fg);
    font-family: var(--font-label);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .ds-translation-link:hover {
    border-color: var(--glow);
    color: var(--glow-text);
  }

  .ds-translation-link:focus-visible {
    outline: 2px solid var(--glow);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ds-translation-link {
      transition: none;
    }
  }

  /* 首圖：無圓角、無底色塊，只有一條細線 */
  .ds-figure {
    margin: 0 0 40px;
  }

  .ds-figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }

  .ds-figure figcaption {
    margin-top: 10px;
    font-family: var(--font-label);
    font-size: 16px;
    letter-spacing: 0.015em;
    color: var(--fg-muted);
    text-align: center;
  }

  /* 正文固定 19px／1.9；標題使用 EB Garamond 與 Noto Serif TC。 */
  .ds-prose {
    font-family: var(--font-body);
    font-size: 19px;
    line-height: 1.85;
    color: var(--fg);
    counter-reset: ds-h2;
  }

  /* Section numerals in lamplight gold. Hanging indent rather than flex: flex would split a
     heading with inline code or bold into separate columns. */
  .ds-prose :global(h2) {
    position: relative;
    margin: 2.4em 0 0.8em;
    padding-left: 40px;
    text-indent: -40px;
    scroll-margin-top: calc(var(--header-h) + 24px);
    font-family: var(--font-cjk-display);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--fg);
    counter-increment: ds-h2;
  }
  .ds-prose :global(h2)::before {
    /* The period keeps a lone "I" from reading as a stray bar */
    content: counter(ds-h2, upper-roman) '.';
    display: inline-block;
    box-sizing: border-box;
    min-width: 40px;
    padding-right: 10px;
    text-indent: 0;
    font-family: var(--font-caps);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: var(--gold-text);
    text-shadow: 0 0 8px var(--gold-glow);
  }

  .ds-prose :global(.ds-anchor) {
    position: absolute;
    top: 0;
    left: -20px;
    text-indent: 0;
    font-family: var(--font-meta);
    font-size: 15px;
    font-weight: 400;
    line-height: 39px;
    color: var(--glow-text);
    text-decoration: none;
    border-bottom: 0;
    opacity: 0;
    transition: opacity var(--t) var(--ease);
  }
  .ds-prose :global(h2:hover .ds-anchor),
  .ds-prose :global(.ds-anchor:focus-visible) {
    opacity: 1;
  }
  @media (hover: none) {
    .ds-prose :global(.ds-anchor) {
      display: none;
    }
  }

  /* Contents: two rules and a plain list, numbered like the headings it points to */
  .ds-toc {
    margin: 0 0 40px;
    border-block: 1px solid var(--rule);
  }
  .ds-toc summary {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    color: var(--fg-muted);
    transition: color var(--t) var(--ease);
  }
  .ds-toc summary::-webkit-details-marker {
    display: none;
  }
  .ds-toc summary:hover {
    color: var(--fg);
  }
  .ds-toc-title {
    font-family: var(--font-caps);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .ds-toc-count {
    font-family: var(--font-meta);
    font-size: 12px;
    line-height: 1;
    color: var(--fg-faint);
  }
  .ds-toc svg {
    width: 12px;
    height: 12px;
    margin-left: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: rotate var(--t) var(--ease);
  }
  .ds-toc details[open] svg {
    rotate: 180deg;
  }
  /* The numeral column grows with the longest numeral (XXXVIII.); subgrid keeps every row aligned */
  .ds-toc ol {
    display: grid;
    grid-template-columns: minmax(26px, max-content) minmax(0, 1fr);
    column-gap: 14px;
    margin: 0;
    padding: 0 0 14px;
    list-style: none;
    counter-reset: ds-toc;
  }
  .ds-toc li {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: baseline;
    counter-increment: ds-toc;
  }
  .ds-toc li::before {
    content: counter(ds-toc, upper-roman) '.';
    font-family: var(--font-caps);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: var(--gold-text);
  }
  .ds-toc a {
    padding-block: 3px;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    color: var(--fg-muted);
    text-decoration: none;
    transition: color var(--t) var(--ease);
  }
  .ds-toc a:hover,
  .ds-toc a:focus-visible {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--glow);
    text-underline-offset: 0.25em;
  }

  .ds-prose :global(h3) {
    margin: 40px 0 12px;
    font-family: var(--font-headline);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--fg);
  }

  .ds-prose :global(h4) {
    margin: 32px 0 10px;
    font-family: var(--font-label);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.055em;
    color: var(--fg-muted);
  }

  .ds-prose :global(p) {
    margin: 0 0 24px;
  }

  .ds-prose :global(ul),
  .ds-prose :global(ol) {
    margin: 0 0 24px;
    padding-left: 1.4em;
  }

  .ds-prose :global(li) {
    margin-bottom: 8px;
  }

  .ds-prose :global(ol > li)::marker {
    font-family: var(--font-caps);
    font-size: 13px;
    color: var(--glow);
  }

  .ds-prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }

  .ds-prose :global(hr) {
    margin: 48px 0;
    border: 0;
    border-top: 1px solid var(--rule);
  }

  .ds-prose :global(table) {
    width: 100%;
    margin: 0 0 24px;
    border-collapse: collapse;
    /* 表格用 15px（Code 級距），不自創級數 */
    font-size: 15px;
  }

  .ds-prose :global(th),
  .ds-prose :global(td) {
    padding: 10px 12px;
    border: 1px solid var(--rule);
    text-align: left;
  }

  .ds-prose :global(th) {
    font-family: var(--font-label);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.055em;
    color: var(--fg-muted);
  }

  /* Reference gallery (About page): two columns, captions read as notes */
  .ds-prose :global(.ds-ref-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 20px;
    margin: 0 0 32px;
  }
  .ds-prose :global(.ds-ref-grid figure) {
    margin: 0;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .ds-prose :global(.ds-ref-grid a) {
    border-bottom: 0;
  }
  .ds-prose :global(.ds-ref-grid img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .ds-prose :global(.ds-ref-grid figcaption) {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.6;
    text-align: left;
    color: var(--fg-muted);
  }
  .ds-prose :global(.ds-ref-grid figcaption a) {
    color: var(--glow-text);
    border-bottom: 1px solid color-mix(in oklab, var(--glow) 45%, transparent);
  }

  @media (max-width: 639px) {
    .ds-prose :global(.ds-ref-grid) {
      grid-template-columns: 1fr;
    }
  }

  /* code block 可溢出到 840px（兩側各 60px），呼應 Overhang Rule */
  .ds-prose :global(pre) {
    width: calc(100% + 120px);
    margin-left: -60px;
    margin-right: -60px;
  }

  @media (max-width: 1023px) {
    .ds-prose :global(pre) {
      width: 100%;
      margin-left: 0;
      margin-right: 0;
    }
  }

  @media (max-width: 767px) {
    .ds-article {
      padding: 32px 0 64px;
    }
    .ds-prose :global(h2) {
      margin-top: 40px;
    }
  }
</style>
