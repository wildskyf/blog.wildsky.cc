---
import dayjs from 'dayjs';
import TagList from '@/components/TagList.astro';
import SeriesBanner from '@/components/SeriesBanner.astro';

const {
  feature_image_url,
  feature_image_caption,
  date,
  title,
  lang,
  category,
  tags,
  readingTime,
  readingMinutes,
  series,
  translation,
} = Astro.props;
const currentLocale = lang || Astro.currentLocale || 'tw';
const root_path = currentLocale === 'en' ? '/en' : '';
const feature_image_alt =
  feature_image_caption
    ?.replace(/<[^>]*>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim() ?? '';

// v9 HUD meta (product decision 2026-11-02)
const publish_time = dayjs(date).format('YYYY.MM.DD');
const minutes = readingMinutes ? `${readingMinutes} MIN` : readingTime;
---

<article class="ds-article">
  <header class="ds-article-head">
    <div class="ds-article-kicker">
      {
        category && (
          <a class="ds-chip" href={`${root_path}/categories/${category}`}>
            {category}
          </a>
        )
      }
      {category && minutes && <span class="ds-meta-sep">/</span>}
      {minutes && <span lang="en">{minutes}</span>}
      {
        date && (
          <>
            <span class="ds-meta-sep">/</span>
            <time datetime={new Date(date).toISOString()}>{publish_time}</time>
          </>
        )
      }
    </div>

    <h1 class="ds-article-title" set:html={title} />

    {
      translation && (
        <a
          class="ds-translation-link"
          href={translation.href}
          hreflang={translation.hreflang}
          lang={translation.hreflang}
        >
          {translation.label}
        </a>
      )
    }

    <TagList tags={tags} lang={currentLocale} />
  </header>

  {series && <SeriesBanner seriesTitle={series.name} seriesUrl={series.url} />}

  {
    feature_image_url && (
      <figure class="ds-figure">
        <img src={feature_image_url} alt={feature_image_alt} width="750" height="410" />
        {feature_image_caption && <figcaption set:html={feature_image_caption} />}
      </figure>
    )
  }

  <div class="article-content ds-prose" lang={currentLocale === 'tw' ? 'zh-Hant-TW' : 'en'}>
    <slot />
  </div>
</article>

<style>
  /* Read mode —— The Boring Body Rule。
     正文沒有容器：直接坐在環境層上，720px 置中，無底色差、無邊框。 */
  .ds-article {
    width: min(var(--measure), 100% - var(--page-gutter) * 2);
    margin-inline: auto;
    padding: 100px 0 96px;
  }

  .ds-article-head {
    margin-bottom: 40px;
  }

  .ds-article-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 28px;
    font-family: var(--font-meta);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--fg-faint);
  }

  .ds-article-kicker :global(.ds-meta-sep) {
    color: var(--rule-strong);
  }

  /* The padding grows the target to ~31px tall; the negative margin keeps the line where it was */
  .ds-article-kicker :global(.ds-chip) {
    display: inline-block;
    padding-block: 4px;
    margin-block: -4px;
    color: var(--fg-faint);
    text-decoration: none;
  }
  .ds-article-kicker :global(.ds-chip:hover) {
    color: var(--fg);
  }

  /* Display 級 —— 全站唯一使用 clamp 的字級 */
  .ds-article-title {
    margin: 0 0 24px;
    font-family: var(--font-cjk-display);
    font-size: clamp(32px, 4.4vw, 46px);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.01em;
    text-wrap: balance;
    background: var(--title-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .ds-translation-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    margin: 0 0 20px;
    padding: 8px 14px;
    border: 1px solid var(--rule);
    background: var(--bg-surface);
    color: var(--fg);
    font-family: var(--font-label);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .ds-translation-link:hover {
    border-color: var(--glow);
    color: var(--glow-text);
  }

  .ds-translation-link:focus-visible {
    outline: 2px solid var(--glow);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ds-translation-link {
      transition: none;
    }
  }

  /* 首圖：無圓角、無底色塊，只有一條細線 */
  .ds-figure {
    margin: 0 0 40px;
  }

  .ds-figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }

  .ds-figure figcaption {
    margin-top: 10px;
    font-family: var(--font-label);
    font-size: 16px;
    letter-spacing: 0.015em;
    color: var(--fg-muted);
    text-align: center;
  }

  /* 正文固定 19px／1.9；標題使用 EB Garamond 與 Noto Serif TC。 */
  .ds-prose {
    font-family: var(--font-body);
    font-size: 19px;
    line-height: 1.85;
    color: var(--fg);
    counter-reset: ds-h2;
  }

  /* Section numerals in lamplight gold */
  .ds-prose :global(h2) {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin: 2.4em 0 0.8em;
    font-family: var(--font-cjk-display);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--fg);
    counter-increment: ds-h2;
  }
  .ds-prose :global(h2)::before {
    content: counter(ds-h2, upper-roman);
    flex: none;
    font-family: var(--font-caps);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: var(--gold-text);
    text-shadow: 0 0 8px var(--gold-glow);
  }

  .ds-prose :global(h3) {
    margin: 40px 0 12px;
    font-family: var(--font-headline);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--fg);
  }

  .ds-prose :global(h4) {
    margin: 32px 0 10px;
    font-family: var(--font-label);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.055em;
    color: var(--fg-muted);
  }

  .ds-prose :global(p) {
    margin: 0 0 24px;
  }

  .ds-prose :global(ul),
  .ds-prose :global(ol) {
    margin: 0 0 24px;
    padding-left: 1.4em;
  }

  .ds-prose :global(li) {
    margin-bottom: 8px;
  }

  .ds-prose :global(ol > li)::marker {
    font-family: var(--font-caps);
    font-size: 13px;
    color: var(--glow);
  }

  .ds-prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }

  .ds-prose :global(hr) {
    margin: 48px 0;
    border: 0;
    border-top: 1px solid var(--rule);
  }

  .ds-prose :global(table) {
    width: 100%;
    margin: 0 0 24px;
    border-collapse: collapse;
    /* 表格用 15px（Code 級距），不自創級數 */
    font-size: 15px;
  }

  .ds-prose :global(th),
  .ds-prose :global(td) {
    padding: 10px 12px;
    border: 1px solid var(--rule);
    text-align: left;
  }

  .ds-prose :global(th) {
    font-family: var(--font-label);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.055em;
    color: var(--fg-muted);
  }

  /* Reference gallery (About page): two columns, captions read as notes */
  .ds-prose :global(.ds-ref-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 20px;
    margin: 0 0 32px;
  }
  .ds-prose :global(.ds-ref-grid figure) {
    margin: 0;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .ds-prose :global(.ds-ref-grid a) {
    border-bottom: 0;
  }
  .ds-prose :global(.ds-ref-grid img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .ds-prose :global(.ds-ref-grid figcaption) {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.6;
    text-align: left;
    color: var(--fg-muted);
  }
  .ds-prose :global(.ds-ref-grid figcaption a) {
    color: var(--glow-text);
    border-bottom: 1px solid color-mix(in oklab, var(--glow) 45%, transparent);
  }

  @media (max-width: 639px) {
    .ds-prose :global(.ds-ref-grid) {
      grid-template-columns: 1fr;
    }
  }

  /* code block 可溢出到 840px（兩側各 60px），呼應 Overhang Rule */
  .ds-prose :global(pre) {
    width: calc(100% + 120px);
    margin-left: -60px;
    margin-right: -60px;
  }

  @media (max-width: 1023px) {
    .ds-prose :global(pre) {
      width: 100%;
      margin-left: 0;
      margin-right: 0;
    }
  }

  @media (max-width: 767px) {
    .ds-article {
      padding: 32px 0 64px;
    }
    .ds-prose :global(h2) {
      margin-top: 40px;
    }
  }
</style>
