---
import HeaderLink from '@/components/HeaderLink.astro';
import { Icon } from 'astro-icon/components';

const { class: className } = Astro.props;
---

<nav class={`flex text-xl lg:text-4xl py-1 gap-6 justify-start text-gray-600 ${className}`}>
  <HeaderLink href="https://g0v.social/wildsky" target="_blank">
    <Icon name="mdi:mastodon" />
  </HeaderLink>

  <HeaderLink href="https://github.com/wildskyf" target="_blank" class="flex items-center">
    <Icon name="fa6-brands:github-square" class="text-lg lg:text-3xl" />
  </HeaderLink>

  <HeaderLink href="https://www.linkedin.com/in/wildsky/" target="_blank">
    <Icon name="ant-design:linkedin-filled" />
  </HeaderLink>

  <HeaderLink href="/files/reseme.pdf" target="_blank" download="wildsky.20220901.pdf">
    <Icon name="bx:paperclip" />
  </HeaderLink>

  <HeaderLink href="/rss.xml" target="_blank">
    <Icon name="mdi:rss-box" />
  </HeaderLink>
</nav>
