---
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge'
import HeaderLink from '@/components/HeaderLink.astro';

const { class: className } = Astro.props;

const linkClass = 'text-base-content opacity-60 hover:opacity-80'
---

<div
  class={twMerge(
    "lg:fixed lg:bottom-8 lg:right-8 lg:flex-col",
    `flex text-xl lg:text-4xl py-1 gap-6 justify-evenly ${className}`
  )}
>
  <HeaderLink href="https://g0v.social/@wildsky" target="_blank" class={linkClass}>
    <Icon name="mdi:mastodon" />
  </HeaderLink>

  <HeaderLink href="https://github.com/wildskyf" target="_blank" class={linkClass}>
    <Icon name="mdi:github" />
  </HeaderLink>

  <HeaderLink href="https://www.linkedin.com/in/wildsky/" target="_blank" class={linkClass}>
    <Icon name="ant-design:linkedin-filled" />
  </HeaderLink>

  <HeaderLink href="/files/reseme.pdf" target="_blank" download="wildsky.20220901.pdf" class={linkClass}>
    <Icon name="mdi:resume" />
  </HeaderLink>

  <HeaderLink href="/rss.xml" target="_blank" class={linkClass}>
    <Icon name="mdi:rss-box" />
  </HeaderLink>
</div>
