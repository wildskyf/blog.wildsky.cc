---
import { Icon } from 'astro-icon/components';

// v7：移除 lg:fixed —— 舊版把整條社群列釘在桌機右下角，
// 與新的直排 watermark 和 footer 都打架。它現在只是 footer 裡的一列。
const links = [
  {
    href: 'https://social.wildsky.cc/@wildsky',
    label: 'Mastodon profile',
    icon: 'ri:mastodon-line',
    rel: 'me noopener noreferrer',
  },
  {
    href: 'https://github.com/wildskyf',
    label: 'GitHub profile',
    icon: 'ri:github-line',
    rel: 'me noopener noreferrer',
  },
  {
    href: 'https://www.linkedin.com/in/wildsky/',
    label: 'LinkedIn profile',
    icon: 'ri:linkedin-box-line',
    rel: 'me noopener noreferrer',
  },
  {
    href: '/files/resume.pdf',
    label: 'Resume PDF',
    icon: 'mdi:file-account-outline',
    download: 'wildsky.20220901.pdf',
  },
  { href: '/rss.xml', label: 'RSS feed', icon: 'ri:rss-line' },
];
---

<div class="ds-social">
  {
    links.map((link) => (
      <a
        href={link.href}
        target={link.href.startsWith('http') ? '_blank' : undefined}
        aria-label={link.label}
        title={link.label}
        download={link.download}
        rel={link.rel}
      >
        <Icon name={link.icon} aria-hidden="true" />
      </a>
    ))
  }
</div>

<style>
  .ds-social {
    display: flex;
    align-items: center;
    gap: 20px;
    /* 圖示尺寸走 Body 級距（19px），不自創級數 */
    font-size: 19px;
  }

  .ds-social a {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    color: var(--fg-muted);
    transition: color var(--t) var(--ease);
  }

  .ds-social a:hover,
  .ds-social a:focus-visible {
    color: var(--glow);
  }

  @media (max-width: 767px) {
    .ds-social {
      gap: 4px;
    }
  }
</style>
