---
// 索引類頁面的標題帶 —— 與首頁 hero 同一個裝置（雙細線刻印帶），
// 只是把「宣言」換成頁名。麵包屑走 chrome 字級。
type Crumb = { label: string; href?: string };

const {
  kicker,
  title,
  desc,
  count,
  crumbs = [],
} = Astro.props as {
  kicker?: string;
  title: string;
  desc?: string;
  count?: string;
  crumbs?: Crumb[];
};
---

<header class="ds-head">
  {
    crumbs.length > 0 && (
      <nav class="ds-crumbs" aria-label="breadcrumb">
        {crumbs.map((c, i) => (
          <>
            {i > 0 && <span class="ds-crumb-sep">/</span>}
            {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          </>
        ))}
      </nav>
    )
  }

  <div class="ds-head-band">
    <span class="ds-head-kicker">{kicker ?? 'Index'}</span>

    <div class="ds-head-main">
      <h1 class="ds-head-title">{title}</h1>
      {desc && <p class="ds-head-desc">{desc}</p>}
    </div>

    {count && <span class="ds-head-count">{count}</span>}
  </div>
</header>

<style>
  .ds-head {
    margin: 56px 0 4px;
  }

  .ds-crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 18px;
    padding-left: var(--gutter-col);
    font-family: var(--font-label);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    font-variant: small-caps;
    color: var(--fg-muted);
  }

  .ds-crumbs a {
    color: var(--fg-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color var(--t) var(--ease),
      border-color var(--t) var(--ease);
  }

  .ds-crumbs a:hover {
    color: var(--fg);
    border-bottom-color: var(--accent);
  }

  .ds-crumb-sep {
    color: var(--rule);
  }

  .ds-head-band {
    position: relative;
    display: grid;
    grid-template-columns: var(--gutter-col) 1fr auto;
    align-items: end;
    gap: 24px;
    padding: 30px 0 26px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .ds-head-band::before,
  .ds-head-band::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: color-mix(in oklab, var(--rule) 55%, transparent);
  }
  .ds-head-band::before {
    top: 4px;
  }
  .ds-head-band::after {
    bottom: 4px;
  }

  .ds-head-kicker {
    grid-column: 1;
    /* kicker 用真的換行字元 —— HTML 實體會被 Astro 當成純文字轉義 */
    white-space: pre-line;
    position: relative;
    padding-left: 18px;
    padding-bottom: 10px;
    font-family: var(--font-label);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    font-variant: small-caps;
    color: var(--fg-muted);
    line-height: 1.4;
  }

  .ds-head-kicker::before {
    content: '';
    position: absolute;
    left: 0;
    top: 4px;
    width: 2px;
    height: 34px;
    background: var(--accent);
  }

  .ds-head-main {
    grid-column: 2;
    min-width: 0;
  }

  .ds-head-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 27px;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: 0.02em;
    color: var(--fg);
  }

  .ds-head-desc {
    margin: 8px 0 0;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.8;
    color: var(--fg-muted);
  }

  .ds-head-count {
    grid-column: 3;
    align-self: end;
    white-space: nowrap;
    font-family: var(--font-label);
    font-size: 13px;
    font-variant: small-caps;
    letter-spacing: 0.06em;
    color: var(--fg-muted);
  }

  @media (max-width: 1119px) {
    .ds-head-band {
      grid-template-columns: 96px 1fr auto;
    }
    .ds-crumbs {
      padding-left: 96px;
    }
  }

  @media (max-width: 767px) {
    .ds-head {
      margin-top: 32px;
    }
    .ds-head-band {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .ds-head-kicker,
    .ds-head-main,
    .ds-head-count {
      grid-column: 1;
    }
    .ds-crumbs {
      padding-left: 0;
    }
    .ds-head-title {
      font-size: 24px;
    }
  }
</style>
