---
const currentLocale = Astro.currentLocale === 'en' ? 'en' : 'tw';
const lightLabel = currentLocale === 'en' ? 'Switch to light theme' : '切換到亮色主題';
---

<button class="ds-theme-toggle ds-plate" type="button" aria-label={lightLabel} title={lightLabel}>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <g class="ds-icon-sun">
      <circle cx="12" cy="12" r="3.5"></circle>
      <path
        d="M12 2.5V5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3 7 7M17 17l1.7 1.7M18.7 5.3 17 7M7 17l-1.7 1.7"
      ></path>
    </g>
    <path class="ds-icon-moon" d="M19.5 15.4A8 8 0 0 1 8.6 4.5 8 8 0 1 0 19.5 15.4Z"></path>
  </svg>
</button>

<style>
  .ds-theme-toggle {
    position: relative;
    z-index: 1;
    width: 44px;
    height: 44px;
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
    --stroke: var(--fg-faint);
    --stroke-inner: var(--rule);
    transition:
      color var(--t) var(--ease),
      background var(--t) var(--ease);
  }

  .ds-theme-toggle:hover,
  .ds-theme-toggle:focus-visible {
    color: var(--glow);
  }

  .ds-theme-toggle svg {
    position: relative;
    z-index: 1;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ds-icon-moon {
    display: none;
  }

  :global(html[data-theme='tide-light']) .ds-icon-sun {
    display: none;
  }

  :global(html[data-theme='tide-light']) .ds-icon-moon {
    display: block;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.ds-theme-toggle').forEach((button) => {
    const root = document.documentElement;
    const isEnglish = root.lang === 'en';

    const sync = () => {
      const isDark = root.dataset.theme === 'tide-dark';
      const label = isDark
        ? isEnglish
          ? 'Switch to light theme'
          : '切換到亮色主題'
        : isEnglish
          ? 'Switch to dark theme'
          : '切換到深色主題';
      button.setAttribute('aria-label', label);
      button.title = label;
    };

    button.addEventListener('click', () => {
      const theme = root.dataset.theme === 'tide-dark' ? 'tide-light' : 'tide-dark';
      root.dataset.theme = theme;
      localStorage.setItem('theme', theme);
      sync();
    });

    sync();
  });
</script>
