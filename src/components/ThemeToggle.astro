---

<button
  class="fixed bottom-8 left-8 z-50 cursor-pointer border-0 bg-transparent p-0 text-xl leading-none text-base-content/80 transition-opacity hover:opacity-60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-base-content/40"
  aria-label="Toggle color theme"
  data-toggle-theme="nord,forest"
  data-act-class="ACTIVECLASS"
>
  <span class="theme-toggle-icon-light animate-pulse" aria-hidden="true">☀︎</span>
  <span class="theme-toggle-icon-dark animate-pulse" aria-hidden="true">☾</span>
</button>

<style>
  .theme-toggle-icon-light {
    display: inline-flex;
  }

  .theme-toggle-icon-dark {
    display: none;
  }

  :global(html[data-theme="forest"]) .theme-toggle-icon-light {
    display: none;
  }

  :global(html[data-theme="forest"]) .theme-toggle-icon-dark {
    display: inline-flex;
  }

  :global(html[data-theme="nord"]) .theme-toggle-icon-light {
    display: inline-flex;
  }

  :global(html[data-theme="nord"]) .theme-toggle-icon-dark {
    display: none;
  }
</style>
