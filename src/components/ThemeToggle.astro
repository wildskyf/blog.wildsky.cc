---
// 主題切換（固定左下）。DESIGN.md：24×24 線框方塊，實心／空心圓區分狀態，
// **不用顏色區分** —— 顏色預算要留給紅色。
---

<button
  class="ds-theme-toggle"
  aria-label="Toggle color theme"
  data-toggle-theme="tide-dark,tide-light"
>
  <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
    <rect x="1.5" y="1.5" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1"
    ></rect>
    <circle class="ds-theme-mark" cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1"
    ></circle>
  </svg>
</button>

<style>
  .ds-theme-toggle {
    position: fixed;
    bottom: 32px;
    left: 32px;
    z-index: 50;
    display: inline-flex;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
    transition: color var(--t) var(--ease);
  }

  .ds-theme-toggle:hover {
    color: var(--glow);
  }

  /* 深色 = 實心（沉在水裡）；淺色 = 空心（浮在水面） */
  .ds-theme-mark {
    fill: currentColor;
  }

  :global(html[data-theme='tide-light']) .ds-theme-mark {
    fill: none;
  }

  @media (max-width: 767px) {
    .ds-theme-toggle {
      bottom: 20px;
      left: 20px;
    }
  }
</style>
