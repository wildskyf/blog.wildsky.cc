---
import dayjs from 'dayjs';
import TagList from '@/components/TagList.astro';

type PostListItem = {
  date: Date | string;
  category?: string | null;
  slug: string;
  title: string;
  tags?: string[];
  readingTime?: string | null;
};

const {
  lang,
  postList,
  showLatest = false,
} = Astro.props as {
  lang?: 'tw' | 'en';
  postList: PostListItem[];
  showLatest?: boolean;
};
const root_path = lang == 'en' ? '/en' : '';
const latestLabel = lang === 'en' ? 'Latest' : '最新';
const titleSegmenter = new Intl.Segmenter(lang === 'en' ? 'en' : 'zh-Hant', {
  granularity: 'word',
});
const containsHan = (value: string) => /[\u3400-\u9fff]/u.test(value);
---

<ul class="ds-index" lang={lang === 'tw' ? 'zh-Hant-TW' : 'en'}>
  {
    postList.map((post, index) => {
      const d = dayjs(post.date);
      const titleSegments = [...titleSegmenter.segment(post.title)];
      return (
        <li class:list={['ds-row', showLatest && index === 0 && 'is-latest']}>
          <span class="ds-row-rule" aria-hidden="true" />
          <span class="ds-row-mark" aria-hidden="true" />

          <div class="ds-row-grid">
            <div class="ds-row-gutter">
              <time datetime={new Date(post.date).toISOString()}>
                <span class="ds-log-day">{d.format('YYYY.MM.DD')}</span>
              </time>
            </div>

            <div class="ds-row-main">
              <div class="ds-row-meta">
                {/* 分類在前，閱讀時間在後 —— 先知道「這是什麼」才有掃讀價值 */}
                {post.category && (
                  <a class="ds-chip" href={`${root_path}/categories/${post.category}`}>
                    {post.category}
                  </a>
                )}
                {post.category && post.readingTime && <span class="ds-meta-sep">·</span>}
                {post.readingTime && <span>{post.readingTime}</span>}
                {showLatest && index === 0 && <span class="ds-seal-tag">{latestLabel}</span>}
              </div>

              <h2 class="ds-row-title">
                <a href={`${root_path}/posts/${post.slug}`}>
                  {titleSegments.map(({ segment, isWordLike }) =>
                    isWordLike && containsHan(segment) ? (
                      <span class="ds-title-phrase">{segment}</span>
                    ) : (
                      segment
                    )
                  )}
                </a>
              </h2>

              <TagList tags={post.tags} lang={lang} />
            </div>
          </div>
        </li>
      );
    })
  }
</ul>

<style>
  .ds-index {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ds-row {
    position: relative;
  }

  .ds-row-rule {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--rule);
    z-index: 1;
  }

  /* The hero already closes with a double rule; avoid a third adjacent separator. */
  .ds-row:first-child .ds-row-rule {
    display: none;
  }

  /* hover 只做兩件事：紅線長出、日期升亮。整列底色不變 ——
     填色面板是軟體 UI 的語彙，在紙與金屬的世界裡不成立。 */
  .ds-row-mark {
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: 100%;
    background: var(--accent);
    z-index: 2;
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 180ms var(--ease);
  }

  .ds-row:focus-within .ds-row-mark {
    transform: scaleY(1);
  }

  .ds-row.is-latest .ds-row-mark {
    transform: scaleY(1);
  }

  .ds-row:focus-within .ds-log-day {
    color: var(--fg);
  }

  @media (hover: hover) and (pointer: fine) {
    .ds-row:hover .ds-row-mark {
      transform: scaleY(1);
    }

    .ds-row:hover .ds-log-day {
      color: var(--fg);
    }
  }

  @media (hover: none), (pointer: coarse) {
    .ds-row:active .ds-row-mark {
      transform: scaleY(1);
    }

    .ds-row:active .ds-log-day {
      color: var(--fg);
    }
  }

  .ds-row-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: var(--gutter-col) minmax(0, var(--measure));
    padding: 30px 0 32px;
  }

  .ds-row-gutter {
    position: relative;
    padding-left: 18px;
  }

  /* 柱首刻線 —— 唯一的青色裝飾線 */
  .ds-row-gutter::before {
    content: '';
    position: absolute;
    left: 0;
    top: 7px;
    width: 9px;
    height: 1px;
    background: var(--glow-line);
  }

  .ds-log-day {
    display: block;
    font-family: var(--font-headline);
    font-size: 23px;
    font-weight: 600;
    letter-spacing: 0.015em;
    color: var(--fg-muted);
    line-height: 1.3;
    transition: color var(--t) var(--ease);
  }

  .ds-row-main {
    min-width: 0;
  }

  .ds-row-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 10px;
    font-family: var(--font-label);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.015em;
    color: var(--fg-muted);
  }

  .ds-meta-sep {
    color: var(--fg-faint);
  }

  /* 分類：沒有框。是「刻線標題」不是按鈕。 */
  .ds-chip {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-label);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.015em;
    color: var(--fg-muted);
    text-decoration-line: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition:
      color var(--t) var(--ease),
      text-decoration-color var(--t) var(--ease);
  }

  /* 不轉紅字：13px 的 --accent-text 在環境層上實測 3.83–4.17，過不了 AA。
     紅色留在線上，文字升到 --fg。 */
  .ds-chip:hover,
  .ds-chip:focus-visible {
    color: var(--fg);
    text-decoration-color: var(--accent);
  }

  .ds-row-title {
    margin: 0 0 14px;
    font-family: var(--font-headline);
    font-size: 28px;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: 0.008em;
    color: var(--fg);
  }

  .ds-row-title a {
    display: block;
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
    word-break: normal;
    text-wrap: pretty;
  }

  .ds-index:lang(zh-Hant-TW) .ds-row-title a {
    line-break: strict;
  }

  .ds-title-phrase {
    white-space: nowrap;
  }

  /* 標題不加底線 —— 底線是網頁語彙，紅線才是這套系統的語彙 */
  .ds-row-title a:hover {
    color: var(--fg);
  }

  @media (max-width: 1119px) {
    .ds-row-grid {
      grid-template-columns: 96px minmax(0, var(--measure));
    }
  }

  @media (max-width: 899px) {
    .ds-row-grid {
      grid-template-columns: 1fr;
      padding: 24px 0 28px;
    }

    .ds-row-gutter {
      grid-column: 1;
      padding-left: 18px;
    }

    .ds-row-main {
      grid-column: 1;
      padding-left: 18px;
    }

    .ds-row-meta {
      margin: 8px 0 10px;
      gap: 8px;
    }

    .ds-chip {
      min-height: 44px;
    }

    .ds-row-title {
      font-size: 26px;
    }
  }

  @media (max-width: 767px) {
    .ds-log-day {
      font-size: 21px;
    }

    .ds-row-title {
      font-size: 24px;
    }
  }
</style>
