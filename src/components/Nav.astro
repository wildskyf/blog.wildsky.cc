---
import HeaderLink from '@/components/HeaderLink.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getTranslation } from '@/i18n/utils.ts';

const currentLocale = Astro.currentLocale || 'tw';
const otherLocale = currentLocale === 'tw' ? 'en' : 'tw';
const t = getTranslation(currentLocale);

// Navigation items based on current locale
const pages =
  currentLocale === 'tw'
    ? [
        { title: t.nav.home, url: '/' },
        { title: t.nav.bookshelf, url: '/bookshelf/' },
        { title: t.nav.about, url: '/about/' },
        { title: t.nav.now, url: '/now/' },
        { title: t.nav.blogroll, url: '/more-links/' },
      ]
    : [
        { title: t.nav.home, url: '/en/' },
        { title: t.nav.about, url: '/en/about-en/' },
      ];

const otherLocaleUrl = getRelativeLocaleUrl(otherLocale, '');
const otherLocaleLabel = otherLocale === 'tw' ? '中文' : 'english';
---

<div class="dropdown dropdown-end">
  <div tabindex="0" role="button" class="btn btn-ghost btn-circle">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      class="inline-block h-5 w-5 stroke-current"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </div>

  <ul
    tabindex="0"
    class={`
      menu menu-lg dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 shadow
      capitalize
    `}
  >
    {
      pages.map((item) => {
        return (
          <li
            class={`
            text-base-content
            w-2/3 lg:w-full
          `}
          >
            <HeaderLink href={item.url}>{item.title}</HeaderLink>
          </li>
        );
      })
    }
    <li
      class={`
        text-base-content
        w-2/3 lg:w-full
    `}
    >
      <HeaderLink href={otherLocaleUrl}>
        {otherLocaleLabel}
      </HeaderLink>
    </li>
  </ul>
</div>

<style>
  @media screen and (max-width: 1023px) {
    #menu {
      display: none;
    }

    #menu-toggler:checked + #menu {
      display: flex;
    }
  }
</style>
