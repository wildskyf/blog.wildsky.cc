---
import HeaderLink from '@/components/HeaderLink.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getTranslation } from '@/i18n/utils.ts';
import type { Locale } from '@/i18n/translations.ts';

const currentLocale = (Astro.currentLocale === 'en' ? 'en' : 'tw') as Locale;
const otherLocale = currentLocale === 'tw' ? 'en' : 'tw';
const t = getTranslation(currentLocale);

// Navigation items based on current locale
const pages =
  currentLocale === 'tw'
    ? [
        { title: t.nav.home, url: '/', group: 'main' },
        { title: t.nav.about, url: '/about/', group: 'main' },
        { title: t.nav.now, url: '/now/', group: 'main' },
        { title: t.nav.notes, url: '/notes/', group: 'main' },
        { title: t.nav.blogroll, url: '/more-links/', group: 'main' },
        { title: t.nav.bookshelf, url: '/bookshelf/', group: 'content' },
        { title: t.nav.categories, url: '/categories/', group: 'content' },
        { title: t.nav.tags, url: '/tags/', group: 'content' },
      ]
    : [
        { title: t.nav.home, url: '/en/', group: 'main' },
        { title: t.nav.about, url: '/en/about-en/', group: 'main' },
        { title: t.nav.blogroll, url : '/en/more-links-en/', group: 'main' },
        { title: t.nav.tags, url: '/en/tags/', group: 'content' },
      ];

const otherLocaleUrl = getRelativeLocaleUrl(otherLocale, '');
const otherLocaleLabel = otherLocale === 'tw' ? '中文' : 'english';
---

<div class="dropdown dropdown-end relative z-50">
  <div tabindex="0" role="button" aria-label="Open navigation menu" class="btn btn-ghost btn-circle">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      class="inline-block h-5 w-5 stroke-current"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </div>

  <ul
    tabindex="0"
    class={`
      menu menu-lg dropdown-content bg-base-100 rounded-box z-50 mt-3 w-52 p-2 shadow
      capitalize
    `}
  >
    {
      pages.map((item, index) => {
        const showDivider = index > 0 && pages[index - 1].group !== item.group;
        return (
          <>
            {showDivider && <li class="divider h-[1px] py-0 my-1" />}

            <li
              class={`
              text-base-content
              w-2/3 lg:w-full
            `}
            >
              <HeaderLink href={item.url}>{item.title}</HeaderLink>
            </li>
          </>
        );
      })
    }

    <li class="divider h-[1px] py-0 my-1" />

    <li
      class={`
        text-base-content
        w-2/3 lg:w-full
    `}
    >
      <HeaderLink href={otherLocaleUrl}>
        {otherLocaleLabel}
      </HeaderLink>
    </li>
  </ul>
</div>

<style>
  @media screen and (max-width: 1023px) {
    #menu {
      display: none;
    }

    #menu-toggler:checked + #menu {
      display: flex;
    }
  }
</style>
