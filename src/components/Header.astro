---
import Nav from '@/components/Nav.astro';
import HeaderLink from '@/components/HeaderLink.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getTranslation } from '@/i18n/utils.ts';

const currentLocale = Astro.currentLocale || 'tw';
const t = getTranslation(currentLocale);
const home_url = getRelativeLocaleUrl(currentLocale, '');
---

<header
  class={`
    border-b border-b-base-content
    px-4
    navbar bg-base-100 shadow-sm
  `}
>
  <div class="flex-1 flex gap-x-2">
    <h1>
      <HeaderLink href={home_url}>
        {t.site.title}
      </HeaderLink>
    </h1>

    <div class="divider-horizontal max-sm:hidden">・</div>

    <p class="max-sm:hidden text-base-content/70">
      {t.site.homeDescription}
    </p>
  </div>

  <Nav />
</header>
