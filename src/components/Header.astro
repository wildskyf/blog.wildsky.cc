---
import Nav from '@/components/Nav.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import MotionToggle from '@/components/MotionToggle.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '@/i18n/translations.ts';

const { pageName } = Astro.props as { pageName?: string };
const currentLocale = (Astro.currentLocale === 'en' ? 'en' : 'tw') as Locale;
const home_url = getRelativeLocaleUrl(currentLocale, '');

// v9: chrome speaks in short English capitals (product decision 2026-11-02).
// No aria-label: the accessible name must contain the visible word (WCAG 2.5.3), so voice control can say "About".
const quickLinks = [
  { title: 'About', url: currentLocale === 'en' ? '/en/about-en/' : '/about/' },
  { title: 'Search', url: currentLocale === 'en' ? '/en/search/' : '/search/' },
  { title: 'Archive', url: currentLocale === 'en' ? '/en/archive/' : '/archive/' },
];
const quickNavLabel = currentLocale === 'en' ? 'Primary navigation' : '主要導覽';
const normalizePath = (path: string) => (path === '/' ? path : path.replace(/\/+$/, ''));
const currentPath = normalizePath(Astro.url.pathname);
const isHome = currentPath === normalizePath(home_url);
const location = isHome ? (currentLocale === 'en' ? 'Home' : '首頁') : pageName;

// 品牌印的字母：站名首字
const seal = 'W';
---

<a class="ds-skip" href="#main">{currentLocale === 'en' ? 'Skip to content' : '跳到內容'}</a>

<header class="ds-header">
  <div class="chrome-inner ds-header-inner">
    <a class="ds-brand" href={home_url}>
      <span class="ds-seal" aria-hidden="true">{seal}</span>
      <span class="ds-brand-name" lang="en">Wildsky</span>
    </a>

    <div class="ds-leader" aria-hidden="true">
      {location && <span class="ds-leader-loc">{location}</span>}
    </div>

    <div class="ds-header-actions">
      <nav class="ds-header-quick-nav" aria-label={quickNavLabel}>
        <ul>
          {
            quickLinks.map((item) => (
              <li>
                <a
                  href={item.url}
                  lang="en"
                  aria-current={currentPath === normalizePath(item.url) ? 'page' : undefined}
                >
                  {item.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <MotionToggle />
      <ThemeToggle />
      <Nav />
    </div>
  </div>
</header>

<style>
  /* Hidden until focused: the first Tab stop on every page */
  .ds-skip {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 40;
    padding: 10px 16px;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--fg);
    background: var(--bg-raised);
    border: 1px solid var(--glow);
    text-decoration: none;
    transform: translateY(calc(-100% - 24px));
    transition: transform var(--t) var(--ease);
  }
  .ds-skip:focus-visible {
    transform: none;
    outline: 2px solid var(--glow);
    outline-offset: 2px;
  }

  /* Sticky, translucent; the water shows through under a light blur */
  .ds-header {
    position: sticky;
    top: 0;
    z-index: 20;
    flex: none;
    height: var(--header-h);
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--water-1) 97%, transparent),
      color-mix(in oklab, var(--water-1) 94%, transparent)
    );
    backdrop-filter: blur(16px) saturate(1.1);
    -webkit-backdrop-filter: blur(16px) saturate(1.1);
    border-bottom: 1px solid var(--rule);
  }

  .ds-header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .ds-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    flex: none;
    color: var(--fg);
    text-decoration: none;
  }

  .ds-brand-name {
    font-family: var(--font-caps);
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* A dotted leader running to the current page name */
  .ds-leader {
    flex: 1;
    min-width: 0;
    display: none;
    align-items: center;
    gap: 10px;
    font-family: var(--font-meta);
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.06em;
    color: var(--fg-faint);
  }
  .ds-leader::before {
    content: '';
    flex: 1;
    height: 1px;
    opacity: 0.8;
    background-image: radial-gradient(var(--fg-faint) 0.8px, transparent 1px);
    background-size: 6px 1px;
    background-repeat: repeat-x;
  }
  .ds-leader-loc {
    max-width: 260px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ds-leader-loc::before {
    content: ': ';
    color: var(--glow);
  }

  .ds-header-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .ds-header-quick-nav {
    display: none;
  }

  .ds-header-quick-nav ul {
    display: flex;
    align-items: center;
    gap: 22px;
    margin: 0 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .ds-header-quick-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-caps);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color var(--t) var(--ease),
      border-color var(--t) var(--ease);
  }

  .ds-header-quick-nav a:hover,
  .ds-header-quick-nav a:focus-visible,
  .ds-header-quick-nav a[aria-current='page'] {
    color: var(--fg);
    border-bottom-color: var(--glow);
  }

  .ds-header-quick-nav a:focus-visible {
    outline: 2px solid var(--glow);
    outline-offset: 2px;
  }

  /* 320–374px: three 44px buttons plus the name only fit with tighter tracking */
  @media (max-width: 374px) {
    .ds-header-inner {
      gap: 12px;
    }
    .ds-brand {
      gap: 10px;
    }
    .ds-brand-name {
      letter-spacing: 0.18em;
    }
    .ds-header-actions {
      gap: 0;
    }
  }

  @media (min-width: 768px) {
    .ds-header-quick-nav {
      display: block;
    }
    .ds-leader {
      display: flex;
    }
  }
</style>
