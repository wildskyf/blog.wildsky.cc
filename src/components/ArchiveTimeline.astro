---
import dayjs from 'dayjs';

type ArchivePost = {
  date: Date | string;
  slug: string;
  title: string;
};

const { lang, posts } = Astro.props as {
  lang: 'tw' | 'en';
  posts: ArchivePost[];
};

const rootPath = lang === 'en' ? '/en' : '';
const groups = new Map<string, ArchivePost[]>();

posts.forEach((post) => {
  const year = dayjs(post.date).format('YYYY');
  const group = groups.get(year) ?? [];
  group.push(post);
  groups.set(year, group);
});
---

<div class="ds-archive" lang={lang === 'tw' ? 'zh-Hant-TW' : 'en'}>
  {
    [...groups].map(([year, yearPosts]) => (
      <section class="ds-archive-year" aria-labelledby={`year-${year}`}>
        <h2 class="ds-archive-year-label" id={`year-${year}`}>
          {year}
        </h2>

        <ol class="ds-archive-list">
          {yearPosts.map((post) => (
            <li class="ds-archive-row">
              <span class="ds-archive-mark" aria-hidden="true" />
              <time datetime={new Date(post.date).toISOString()}>
                {dayjs(post.date).format('MM.DD')}
              </time>
              <a href={`${rootPath}/posts/${post.slug}`}>{post.title}</a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .ds-archive {
    padding-top: 18px;
  }

  .ds-archive-year {
    display: grid;
    grid-template-columns: var(--gutter-col) minmax(0, var(--measure));
  }

  .ds-archive-year-label {
    position: relative;
    margin: 0;
    padding: 22px 0 0 18px;
    font-family: var(--font-headline);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--fg-muted);
  }

  .ds-archive-year-label::before {
    content: '';
    position: absolute;
    top: 33px;
    left: 0;
    width: 9px;
    height: 1px;
    background: var(--glow-line);
  }

  .ds-archive-list {
    grid-column: 2;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ds-archive-row {
    position: relative;
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    align-items: baseline;
    min-height: 54px;
    border-top: 1px solid var(--rule);
  }

  .ds-archive-row:first-child {
    border-top: 0;
  }

  .ds-archive-mark {
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 180ms var(--ease);
  }

  .ds-archive-row time {
    padding: 13px 10px 13px 16px;
    font-family: var(--font-meta);
    font-size: 12px;
    letter-spacing: 0.045em;
    color: var(--fg-muted);
  }

  .ds-archive-row a {
    display: flex;
    align-items: center;
    min-height: 54px;
    padding: 8px 0;
    font-family: var(--font-headline);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--fg);
    text-decoration: none;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .ds-archive-row:focus-within .ds-archive-mark {
    transform: scaleY(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .ds-archive-row:hover .ds-archive-mark {
      transform: scaleY(1);
    }
  }

  @media (max-width: 1119px) {
    .ds-archive-year {
      grid-template-columns: 96px minmax(0, var(--measure));
    }
  }

  @media (max-width: 767px) {
    .ds-archive {
      padding-top: 8px;
    }

    .ds-archive-year {
      grid-template-columns: 1fr;
    }

    .ds-archive-year-label,
    .ds-archive-list {
      grid-column: 1;
    }

    .ds-archive-year-label {
      padding: 26px 0 8px 18px;
      font-size: 24px;
    }

    .ds-archive-year-label::before {
      top: 38px;
    }

    .ds-archive-row {
      grid-template-columns: 64px minmax(0, 1fr);
      min-height: 50px;
    }

    .ds-archive-row time {
      padding-left: 14px;
    }

    .ds-archive-row a {
      min-height: 50px;
      font-size: 19px;
      line-height: 1.35;
    }
  }
</style>
