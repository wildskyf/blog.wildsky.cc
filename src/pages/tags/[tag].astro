---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/page.astro';
import PageHead from '@/components/PageHead.astro';
import PostList from '@/components/PostList.astro';
import { articleMapper, formatReadingTime } from '@/utils';

type PostEntry = CollectionEntry<'posts-tw'>;

export const getStaticPaths = async () => {
  const posts = await getCollection('posts-tw');
  const tagPosts = new Map<string, PostEntry[]>();

  // 收集所有標籤和對應的文章
  posts.forEach((post) => {
    if (post.data.tags) {
      post.data.tags.forEach((tag) => {
        if (!tagPosts.has(tag)) {
          tagPosts.set(tag, []);
        }
        tagPosts.get(tag)!.push(post);
      });
    }
  });

  // 為每個標籤生成路由
  return Array.from(tagPosts.entries()).map(([tag, taggedPosts]) => ({
    params: { tag },
    props: {
      tag,
      posts: taggedPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
};

const { tag, posts } = Astro.props as { tag: string; posts: PostEntry[] };

const pageTitle = `標籤：${tag}`;
const pageDescription = `查看所有標記為「${tag}」的文章，共 ${posts.length} 篇`;

const rows = posts.map((post) => {
  const mapped = articleMapper(post);
  return {
    ...mapped,
    readingTime: mapped.readingMinutes ? formatReadingTime(mapped.readingMinutes, 'tw') : null,
  };
});
---

<Layout pageName={pageTitle} pageDesc={pageDescription}>
  <div class="chrome-inner">
    <PageHead
      kicker={`Tag
Archive`}
      title={`標籤：${tag}`}
      crumbs={[{ label: '首頁', href: '/' }, { label: '標籤列表', href: '/tags' }, { label: tag }]}
      count={`${posts.length} Entries`}
    />

    {
      rows.length > 0 ? (
        <PostList lang="tw" postList={rows} />
      ) : (
        <div class="ds-body">
          <p class="ds-empty">
            標籤「{tag}」目前沒有文章。你可以<a href="/tags">瀏覽其他標籤</a>，或
            <a href="/">回到首頁</a>。
          </p>
        </div>
      )
    }

    <div class="ds-body ds-back">
      <a class="ds-btn ds-plate" href="/tags">返回標籤列表</a>
    </div>
  </div>
</Layout>
