---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/page.astro';
import PageHead from '@/components/PageHead.astro';
import CategoryIndex from '@/components/CategoryIndex.astro';

// Get all posts
const posts = await getCollection('posts-tw');

// Define category list and descriptions
const categoryInfo = {
  軟體工程: {
    description: '程式設計、網頁開發、系統管理等技術相關文章',
  },
  職涯工作: {
    description: '工作經驗、職涯發展、專業成長相關分享',
  },
  生活體驗: {
    description: '旅遊、音樂、藝術等生活體驗與觀察',
  },
  思考觀點: {
    description: '人生哲學、價值觀念、思辨與反思',
  },
  理財投資: {
    description: '理財規劃、投資心得、財務觀念分享',
  },
  資訊科學: {
    description: '電腦科學理論、數學、學術知識',
  },
  其他: {
    description: '其他未分類的文章內容',
  },
};

// Count posts by category
const categoryCounts = new Map();
posts.forEach((post) => {
  if (post.data.category) {
    categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) || 0) + 1);
  }
});

// Prepare category data
const categories = Object.entries(categoryInfo)
  .map(([name, info]) => ({
    name,
    ...info,
    count: categoryCounts.get(name) || 0,
  }))
  // 只列出真的有文章的分類：空分類不會被 getStaticPaths 產生路由，
  // 列出來就是死連結（實測 /en/categories/* 全部 404）
  .filter((c) => c.count > 0);

const pageTitle = '文章分類';
const pageDescription = '按主題分類瀏覽所有文章，快速找到感興趣的內容';
---

<Layout pageName={pageTitle} pageDesc={pageDescription}>
  <div class="chrome-inner">
    <PageHead
      kicker={`Category
Index`}
      title={pageTitle}
      desc={pageDescription}
      count={`${categories.length} Categories`}
    />

    <CategoryIndex
      lang="tw"
      categories={categories.map((category) => ({
        ...category,
        href: `/categories/${encodeURIComponent(category.name)}/`,
      }))}
    />
  </div>
</Layout>
