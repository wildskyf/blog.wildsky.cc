---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/page.astro';
import PageHead from '@/components/PageHead.astro';
import PostList from '@/components/PostList.astro';
import { articleMapper, formatReadingTime } from '@/utils';

type PostEntry = CollectionEntry<'posts-tw'>;

export const getStaticPaths = async () => {
  const posts = await getCollection('posts-tw');
  const categoryPosts = new Map<string, PostEntry[]>();

  // Collect all categories and their corresponding posts
  posts.forEach((post) => {
    if (post.data.category) {
      const category = post.data.category;
      if (!categoryPosts.has(category)) {
        categoryPosts.set(category, []);
      }
      categoryPosts.get(category)!.push(post);
    }
  });

  // Generate route for each category
  return Array.from(categoryPosts.entries()).map(([category, categoryPosts]) => ({
    params: { category },
    props: {
      category,
      posts: categoryPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
};

const { category, posts } = Astro.props as { category: string; posts: PostEntry[] };

const pageTitle = `分類：${category}`;
const pageDescription = `查看所有「${category}」分類的文章，共 ${posts.length} 篇`;

const rows = posts.map((post) => {
  const mapped = articleMapper(post);
  return {
    ...mapped,
    readingTime: mapped.readingMinutes ? formatReadingTime(mapped.readingMinutes, 'tw') : null,
  };
});
---

<Layout pageName={pageTitle} pageDesc={pageDescription}>
  <div class="chrome-inner">
    <PageHead
      kicker={`Category
Archive`}
      title={`分類：${category}`}
      crumbs={[
        { label: '首頁', href: '/' },
        { label: '文章分類', href: '/categories' },
        { label: category },
      ]}
      count={`${posts.length} Entries`}
    />

    {
      rows.length > 0 ? (
        <PostList lang="tw" postList={rows} />
      ) : (
        <div class="ds-body">
          <p class="ds-empty">
            分類「{category}」目前沒有文章。你可以<a href="/categories">瀏覽其他分類</a>，或
            <a href="/">回到首頁</a>。
          </p>
        </div>
      )
    }

    <div class="ds-body ds-back">
      <a class="ds-btn ds-plate" href="/categories">返回分類列表</a>
    </div>
  </div>
</Layout>
