---
import PageLayout from '@/layouts/page.astro';

const pageName = 'Notes';
const pageDesc = '我的一些 murmur；想看更新可以 follow @wildsky@social.wildsky.cc。';
---

<PageLayout lang="tw" pageName={pageName} pageDesc={pageDesc}>
  <article
    class="prose prose-xl max-md:prose-lg max-w-none bg-base-100 px-6 lg:px-12 mt-0 lg:mt-4 pt-8 pb-16 prose-zh tracking-tw-normal"
  >
    <header class="not-prose mb-8">
      <p class="text-sm uppercase tracking-[0.18em] text-secondary/80 mb-2">GoToSocial</p>
      <h1 class="text-3xl lg:text-4xl font-bold text-base-content mb-4 tracking-tw-normal">
        Notes
      </h1>
      <p class="text-base lg:text-lg text-base-content/70 leading-8 max-w-2xl">
        這裡是我的一些 murmur。想看更新，可以直接 follow
        <a class="ds-link" href="https://social.wildsky.cc/@wildsky" rel="me"
          >@wildsky@social.wildsky.cc</a
        >。
      </p>
    </header>

    <section
      id="notes-feed"
      class="notes-feed not-prose"
      data-notes-endpoint="/api/notes"
      aria-live="polite"
      aria-busy="true"
    >
      <p class="notes-muted" data-notes-loading>載入 notes 中…</p>
      <noscript>
        <p class="notes-muted">
          需要 JavaScript 才能載入即時 notes。你也可以直接查看 <a
            class="ds-link"
            href="https://social.wildsky.cc/@wildsky/feed.rss">RSS feed</a
          >。
        </p>
      </noscript>
    </section>
  </article>

  <script is:inline>
    (() => {
      const root = document.getElementById('notes-feed');
      if (!root) return;

      const endpoint = root.dataset.notesEndpoint || '/api/notes';
      const pageSize = 10;
      let nextCursor = '';
      let isLoading = false;
      let list = null;
      let loadMoreButton = null;
      let status = null;

      const buildUrl = (cursor = '') => {
        const url = new URL(endpoint, window.location.origin);
        url.searchParams.set('limit', String(pageSize));
        if (cursor) url.searchParams.set('cursor', cursor);
        return url.toString();
      };

      const setBusy = (busy) => {
        isLoading = busy;
        root.setAttribute('aria-busy', busy ? 'true' : 'false');
        if (loadMoreButton) {
          loadMoreButton.disabled = busy;
          loadMoreButton.textContent = busy ? '載入中…' : '載入更多 notes';
        }
      };

      const setStatus = (message = '') => {
        if (status) status.textContent = message;
      };

      const renderFallback = (message = '') => {
        setBusy(false);
        root.innerHTML = message ? `<p class="notes-muted">${message}</p>` : '';
      };

      const updatePager = (payload) => {
        nextCursor = payload && payload.hasMore && payload.nextCursor ? payload.nextCursor : '';

        if (!loadMoreButton || !status) return;

        loadMoreButton.hidden = !nextCursor;
        setStatus(nextCursor ? '' : '沒有更多公開 notes 了。');
      };

      const wirePager = () => {
        list = root.querySelector('.notes-list');
        loadMoreButton = root.querySelector('[data-notes-load-more]');
        status = root.querySelector('[data-notes-status]');

        if (loadMoreButton) {
          loadMoreButton.addEventListener('click', () => {
            if (!nextCursor || isLoading || !list) return;

            setBusy(true);
            setStatus('');
            fetchNotes(nextCursor)
              .then((payload) => {
                if (payload && typeof payload.html === 'string' && payload.html.trim()) {
                  list.insertAdjacentHTML('beforeend', payload.html);
                  updatePager(payload);
                } else {
                  updatePager({ hasMore: false, nextCursor: '' });
                }
              })
              .catch(() => {
                setStatus('載入失敗，稍後再試。');
              })
              .finally(() => {
                setBusy(false);
              });
          });
        }
      };

      const renderInitial = (payload) => {
        setBusy(false);

        if (payload && typeof payload.html === 'string' && payload.html.trim()) {
          root.innerHTML = `
            <div class="notes-list">${payload.html}</div>
            <div class="notes-actions">
              <button type="button" class="notes-load-more" data-notes-load-more>載入更多 notes</button>
              <p class="notes-status" data-notes-status aria-live="polite"></p>
            </div>
          `;
          wirePager();
          updatePager(payload);
          return;
        }

        renderFallback('目前沒有公開 notes。');
      };

      const fetchNotes = (cursor = '') =>
        fetch(buildUrl(cursor), {
          headers: { accept: 'application/json' },
          credentials: 'same-origin',
        }).then((response) =>
          response.ok ? response.json() : Promise.reject(new Error(`notes api ${response.status}`))
        );

      fetchNotes()
        .then(renderInitial)
        .catch(() => {
          renderFallback('Notes 暫時讀不到；部落格本體不受影響。');
        });
    })();
  </script>
</PageLayout>
