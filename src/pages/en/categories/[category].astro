---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/page.astro';
import PageHead from '@/components/PageHead.astro';
import PostList from '@/components/PostList.astro';
import { articleMapper, formatReadingTime } from '@/utils';

type PostEntry = CollectionEntry<'posts-en'>;

export const getStaticPaths = async () => {
  const posts = await getCollection('posts-en');
  const categoryPosts = new Map<string, PostEntry[]>();

  // Collect all categories and their corresponding posts
  posts.forEach((post) => {
    if (post.data.category) {
      const category = post.data.category;
      if (!categoryPosts.has(category)) {
        categoryPosts.set(category, []);
      }
      categoryPosts.get(category)!.push(post);
    }
  });

  // Generate route for each category
  return Array.from(categoryPosts.entries()).map(([category, categoryPosts]) => ({
    params: { category },
    props: {
      category,
      posts: categoryPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
};

const { category, posts } = Astro.props as { category: string; posts: PostEntry[] };

const pageTitle = `Category: ${category}`;
const pageDescription = `Browse all articles in "${category}" category, ${posts.length} posts found`;

const rows = posts.map((post) => {
  const mapped = articleMapper(post);
  return {
    ...mapped,
    readingTime: mapped.readingMinutes ? formatReadingTime(mapped.readingMinutes, 'en') : null,
  };
});
---

<Layout pageName={pageTitle} pageDesc={pageDescription}>
  <div class="chrome-inner">
    <PageHead
      kicker={`Category
Archive`}
      title={`Category: ${category}`}
      crumbs={[
        { label: 'Home', href: '/en/' },
        { label: 'Categories', href: '/en/categories' },
        { label: category },
      ]}
      count={`${posts.length} Entries`}
    />

    {
      rows.length > 0 ? (
        <PostList lang="en" postList={rows} />
      ) : (
        <div class="ds-body">
          <p class="ds-empty">
            No posts under “{category}” yet. <a href="/en/categories">Browse other categories</a> or{' '}
            <a href="/en/">go home</a>.
          </p>
        </div>
      )
    }

    <div class="ds-body ds-back">
      <a class="ds-btn ds-plate" href="/en/categories">Back to all categories</a>
    </div>
  </div>
</Layout>
