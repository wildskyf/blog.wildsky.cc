---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/page.astro';
import PageHead from '@/components/PageHead.astro';
import { getTagPath } from '@/utils';

// Get all English posts
const posts = await getCollection('posts-en');
type TagCount = { name: string; count: number };

// Count tag usage
const tagCounts = new Map<string, number>();

posts.forEach((post) => {
  if (post.data.tags) {
    post.data.tags.forEach((tag) => {
      tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
    });
  }
});

// Organize tags by category
const tagCategories: Record<string, TagCount[]> = {
  Technology: [],
  'Career & Work': [],
  'Life Experience': [],
  'Thoughts & Views': [],
  'Finance & Investment': [],
  'Academic Research': [],
  Others: [],
};

// Define keywords for each category (English version)
const categoryKeywords: Record<string, string[]> = {
  Technology: [
    'frontend',
    'backend',
    'programming',
    'javascript',
    'react',
    'nextjs',
    'vuejs',
    'typescript',
    'python',
    'ruby',
    'c',
    'linux',
    'ubuntu',
    'macos',
    'windows',
    'android',
    'git',
    'vim',
    'docker',
    'mysql',
    'api',
    'database',
    'web',
    'development',
    'devtools',
    'system',
    'security',
    'upload',
    'static',
    'jekyll',
    'hugo',
    'pwa',
    'serviceworker',
    'editor',
    'version control',
    'installation',
    'optimization',
    'environment',
    'troubleshooting',
  ],
  'Career & Work': [
    'engineer',
    'career',
    'internship',
    'workplace',
    'professional',
    'work',
    'learning',
    'skills',
    'communication',
    'project',
    'team',
    'time management',
    'business',
    'growth',
  ],
  'Life Experience': [
    'travel',
    'europe',
    'music',
    'guitar',
    'theory',
    'concert',
    'movie',
    'art',
    'culture',
    'life',
    'daily',
    'experience',
    'germany',
    'czech',
    'nuremberg',
    'bamberg',
    'prague',
    'interval',
    'capo',
    'festival',
    'creation',
    'emotion',
  ],
  'Thoughts & Views': [
    'philosophy',
    'values',
    'life',
    'freedom',
    'thinking',
    'politics',
    'society',
    'democracy',
    'logic',
    'framework',
    'science',
    'exploration',
    'critical',
    'growth',
    'psychology',
    'behavior',
    'habits',
    'reading',
  ],
  'Finance & Investment': [
    'finance',
    'investment',
    'stock',
    'money',
    'management',
    'learning',
    'financial',
    'market',
    'analysis',
    'education',
    'knowledge',
    'value',
    'strategy',
    'planning',
    'mindset',
  ],
  'Academic Research': [
    'operating system',
    'computer science',
    'architecture',
    'interrupt',
    'storage',
    'process',
    'linear algebra',
    'mathematics',
    'vector',
    'subspace',
    'notes',
    'academic',
  ],
};

// Categorize tags
Array.from(tagCounts.keys()).forEach((tag) => {
  let categorized = false;

  for (const [category, keywords] of Object.entries(categoryKeywords)) {
    if (keywords.some((keyword) => tag.toLowerCase().includes(keyword.toLowerCase()))) {
      tagCategories[category].push({
        name: tag,
        count: tagCounts.get(tag) ?? 0,
      });
      categorized = true;
      break;
    }
  }

  if (!categorized) {
    tagCategories['Others'].push({
      name: tag,
      count: tagCounts.get(tag) ?? 0,
    });
  }
});

// Sort tags in each category by count
Object.keys(tagCategories).forEach((category) => {
  tagCategories[category].sort((a, b) => b.count - a.count);
});

const pageTitle = 'Tags';
const pageDescription = 'Browse all tags by category to quickly find articles of interest';
---

<Layout pageName={pageTitle} pageDesc={pageDescription}>
  <div class="chrome-inner">
    <PageHead
      kicker={`Tag
Index`}
      title={pageTitle}
      desc={pageDescription}
      count={`${Array.from(tagCounts.keys()).length} Tags`}
    />

    <div class="ds-body">
      {
        Object.entries(tagCategories).map(
          ([category, tags]) =>
            tags.length > 0 && (
              <section class="ds-section">
                <h2 class="ds-section-title">{category}</h2>
                <div class="ds-cloud">
                  {tags.map((tag) => (
                    <a class="ds-cloud-item" href={getTagPath(tag.name, 'en')}>
                      {tag.name}
                      <span class="ds-count">{tag.count}</span>
                    </a>
                  ))}
                </div>
              </section>
            )
        )
      }
    </div>
  </div>
</Layout>
