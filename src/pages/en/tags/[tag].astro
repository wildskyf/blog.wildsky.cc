---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/page.astro';
import PageHead from '@/components/PageHead.astro';
import PostList from '@/components/PostList.astro';
import { articleMapper, formatReadingTime, getTagRouteSegment } from '@/utils';
import { getRobotsDirective, shouldIndexPath } from '@/utils/indexPolicy.mjs';

type PostEntry = CollectionEntry<'posts-en'>;

export const getStaticPaths = async () => {
  const posts = await getCollection('posts-en');
  const tagPosts = new Map<string, PostEntry[]>();

  // Collect all tags and corresponding posts
  posts.forEach((post) => {
    if (post.data.tags) {
      post.data.tags.forEach((tag) => {
        if (!tagPosts.has(tag)) {
          tagPosts.set(tag, []);
        }
        tagPosts.get(tag)!.push(post);
      });
    }
  });

  // Generate routes for each tag
  return Array.from(tagPosts.entries()).map(([tag, taggedPosts]) => ({
    params: { tag: getTagRouteSegment(tag) },
    props: {
      tag,
      posts: taggedPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
};

const { tag, posts } = Astro.props as { tag: string; posts: PostEntry[] };

const pageTitle = `Tag: ${tag}`;
const pageDescription = `View all articles tagged with "${tag}", ${posts.length} posts found`;

const rows = posts.map((post) => {
  const mapped = articleMapper(post);
  return {
    ...mapped,
    readingTime: mapped.readingMinutes ? formatReadingTime(mapped.readingMinutes, 'en') : null,
  };
});
---

<Layout
  pageName={pageTitle}
  pageDesc={pageDescription}
  robots={getRobotsDirective(shouldIndexPath(Astro.url.pathname, posts.length))}
>
  <div class="chrome-inner">
    <PageHead
      kicker={`Tag
Archive`}
      title={`Tag: ${tag}`}
      crumbs={[
        { label: 'Home', href: '/en/' },
        { label: 'Tags', href: '/en/tags' },
        { label: tag },
      ]}
      count={`${posts.length} Entries`}
    />

    {
      rows.length > 0 ? (
        <PostList lang="en" postList={rows} />
      ) : (
        <div class="ds-body">
          <p class="ds-empty">
            No posts under “{tag}” yet. <a href="/en/tags">Browse other tags</a> or{' '}
            <a href="/en/">go home</a>.
          </p>
        </div>
      )
    }

    <div class="ds-body ds-back">
      <a class="ds-btn ds-plate" href="/en/tags">Back to all tags</a>
    </div>
  </div>
</Layout>
