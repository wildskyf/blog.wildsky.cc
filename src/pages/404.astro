---
import PageLayout from '@/layouts/page.astro';
import { NOINDEX_ROBOTS } from '@/utils/indexPolicy.mjs';
import PageHead from '@/components/PageHead.astro';

const LANG = 'en';
const pageName = 'Not Found';
const pageDesc = 'This page has drifted out of reach.';
---

<PageLayout lang={LANG} pageName="404 Not Found" pageDesc={pageDesc} robots={NOINDEX_ROBOTS}>
  <div class="chrome-inner">
    <PageHead
      kicker={`Lost
Signal`}
      title={pageName}
      desc={pageDesc}
      count="404"
    />

    <div class="ds-body">
      <p class="ds-empty">
        The address you followed does not exist, or the post has moved. Every old URL on this site
        is meant to keep working — if you got here from a link on this site, that is a bug worth
        telling me about.
      </p>

      <div class="ds-back">
        <a class="ds-btn ds-plate" href="/">Back to home</a>
      </div>
    </div>
  </div>
</PageLayout>
