---
import PageLayout from '@/layouts/page.astro';
import Button from '@/components/Button.astro';

const LANG = 'en';
const pageName = '404 NotFound';
const pageDesc = 'The page can not be found.';
---

<PageLayout {...{ lang: LANG }}>
  <div class="flex justify-center items-center">
    <div class="py-24">
      <h1 class="text-5xl font-bold text-base-content/80 pb-4">
        {pageName}
      </h1>

      <p
        class="w-full mb-8 inline-block text-5xl text-base-content/50 whitespace-nowrap origin-bottom-left"
      >
        {pageDesc}
      </p>

      <Button to="/" text="back to home" />
    </div>
  </div>
</PageLayout>
