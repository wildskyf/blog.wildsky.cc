---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/page.astro';
import PageHead from '@/components/PageHead.astro';
import { getTagPath } from '@/utils';

// 獲取所有文章
const posts = await getCollection('posts-tw');
type TagCount = { name: string; count: number };

// 統計標籤使用情況
const tagCounts = new Map<string, number>();

posts.forEach((post) => {
  if (post.data.tags) {
    post.data.tags.forEach((tag) => {
      tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
    });
  }
});

// 將標籤按照分類整理
const tagCategories: Record<string, TagCount[]> = {
  軟體工程: [],
  職涯工作: [],
  生活體驗: [],
  思考觀點: [],
  理財投資: [],
  資訊科學: [],
  其他: [],
};

// 定義每個分類的關鍵字
const categoryKeywords: Record<string, string[]> = {
  軟體工程: [
    '前端開發',
    '後端開發',
    '程式設計',
    'JavaScript',
    'React',
    'Next.js',
    'Vue.js',
    'TypeScript',
    'Python',
    'Ruby',
    'C語言',
    'Linux',
    'Ubuntu',
    'macOS',
    'Windows',
    'Android',
    'Git',
    'Vim',
    'Docker',
    'MySQL',
    'API',
    '資料庫',
    '網頁技術',
    '開發工具',
    '系統管理',
    '網路安全',
    '檔案上傳',
    '靜態網站',
    'Jekyll',
    'Hugo',
    'PWA',
    'Service Worker',
    '編輯器',
    '版本控制',
    '系統安裝',
    '系統優化',
    '開發環境',
    '故障排除',
    'Caddy',
    'Kubernetes',
    'fail2ban',
    'Knex.js',
    'XState',
    'Ramda.js',
    'Pandas',
    'Electron',
    'Fedora',
    '開發技巧',
  ],
  職涯工作: [
    '工程師',
    '職涯發展',
    '實習心得',
    '職場經驗',
    '專業發展',
    '工作態度',
    '學習成長',
    '技能培養',
    '溝通技巧',
    '專案管理',
    '團隊合作',
    '時間管理',
    '商業價值',
    '職涯思考',
  ],
  生活體驗: [
    '歐洲旅遊',
    '旅行日記',
    '音樂',
    '吉他',
    '樂理',
    '演唱會',
    '電影評論',
    '藝術鑑賞',
    '文化評論',
    '生活觀察',
    '日常記錄',
    '學習體驗',
    '德國',
    '捷克',
    '紐倫堡',
    '班堡',
    '布拉格',
    '音程',
    '移調夾',
    '音樂節',
    '創作',
    '情感分享',
    '魯拉帕路薩',
    '詞彙研究',
    '文化觀察',
  ],
  思考觀點: [
    '人生哲學',
    '價值觀念',
    '生命思辨',
    '自由思考',
    '哲學思辯',
    '政治思考',
    '社會議題',
    '民主參與',
    '公投分析',
    '邏輯思維',
    '思維框架',
    '科學思考',
    '探索精神',
    '批判思考',
    '個人成長',
    '心理觀察',
    '行為分析',
    '習慣養成',
    '讀書心得',
    '生活哲學',
    '自由意志',
    '黑天鵝效應',
    '思維實驗',
    '資訊管理',
    '分類系統',
  ],
  理財投資: [
    '理財規劃',
    '投資心得',
    '股票投資',
    '財務觀念',
    '金錢管理',
    '投資學習',
    '財務報表',
    '市場分析',
    '投資教育',
    '金融知識',
    '價值投資',
    '投資策略',
    '理財教育',
    '投資入門',
    '投資心態',
    '理財觀念',
    '金錢思維',
    '金融市場',
  ],
  資訊科學: [
    '作業系統',
    '電腦科學',
    '系統架構',
    '中斷處理',
    '儲存架構',
    '程序管理',
    '線性代數',
    '數學理論',
    '向量空間',
    'Subspace',
    '數學',
    '學術',
  ],
};

// 將標籤分類
Array.from(tagCounts.keys()).forEach((tag) => {
  let categorized = false;

  for (const [category, keywords] of Object.entries(categoryKeywords)) {
    if (keywords.includes(tag)) {
      tagCategories[category].push({
        name: tag,
        count: tagCounts.get(tag) ?? 0,
      });
      categorized = true;
      break;
    }
  }

  if (!categorized) {
    tagCategories['其他'].push({
      name: tag,
      count: tagCounts.get(tag) ?? 0,
    });
  }
});

// 對每個分類的標籤按文章數量排序
Object.keys(tagCategories).forEach((category) => {
  tagCategories[category].sort((a, b) => b.count - a.count);
});

const pageTitle = '標籤列表';
const pageDescription = '按分類瀏覽所有標籤，快速找到感興趣的文章主題';
---

<Layout pageName={pageTitle} pageDesc={pageDescription}>
  <div class="chrome-inner">
    <PageHead
      kicker={`Tag
Index`}
      title={pageTitle}
      desc={pageDescription}
      count={`${Array.from(tagCounts.keys()).length} Tags`}
    />

    <div class="ds-body">
      {
        Object.entries(tagCategories).map(
          ([category, tags]) =>
            tags.length > 0 && (
              <section class="ds-section">
                <h2 class="ds-section-title">{category}</h2>
                <div class="ds-cloud">
                  {tags.map((tag) => (
                    <a class="ds-cloud-item" href={getTagPath(tag.name, 'tw')}>
                      {tag.name}
                      <span class="ds-count">{tag.count}</span>
                    </a>
                  ))}
                </div>
              </section>
            )
        )
      }
    </div>
  </div>
</Layout>
