          <div class="text-2xl font-bold text-purple-600">
            {Math.max(...Array.from(tagCounts.values()))}
          </div>
          <div class="text-sm text-gray-600">最多文章數</div>
        </div>
        <div>
          <div class="text-2xl font-bold text-orange-600">
            {(Array.from(tagCounts.values()).reduce((a, b) => a + b, 0) / Array.from(tagCounts.keys()).length).toFixed(1)}
          </div>
          <div class="text-sm text-gray-600">平均文章數</div>
        </div>
      </div>
    </section>
    -->
