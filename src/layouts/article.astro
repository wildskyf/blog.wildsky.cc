---
import PageLayout from './page.astro'
import ArticleSection from '@/components/Article.astro'
import { articleMapper } from '@/utils'

const { frontmatter } = Astro.props
const data = articleMapper({ data: frontmatter })

const currentLocale = Astro.currentLocale || 'tw'

---

<PageLayout
  lang={currentLocale}
  pageName={data.title}
  pageDesc={data.excerpt}
>
  <ArticleSection {...data}>
    <slot />
  </ArticleSection>
</PageLayout>
