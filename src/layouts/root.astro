---
import dayjs from 'dayjs';
import timezone from 'dayjs/plugin/timezone';
import Head from '@/components/Head.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import '../global.css';

dayjs.extend(timezone);
dayjs.tz.setDefault('Asia/Taipei');

const currentLocale = Astro.currentLocale || 'tw';
const htmlLang = currentLocale === 'tw' ? 'zh-hant-tw' : 'en';

const { pageName, pageDesc, pageImage, pageType, pagePublished, pageUpdated, schema } = Astro.props;
---

<html lang={htmlLang}>
  <head>
    <script is:inline>
      if (localStorage.getItem('theme') === null) {
        document.documentElement.setAttribute('data-theme', 'nord');
      } else document.documentElement.setAttribute('data-theme', localStorage.getItem('theme'));
    </script>
    <script>
      import { themeChange } from 'theme-change';
      themeChange();
    </script>

    <link rel="me" href="https://social.wildsky.cc/@wildsky" />
    <link rel="me" href="https://github.com/wildskyf" />
    <link rel="me" href="https://www.linkedin.com/in/wildsky/" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta content="light" name="color-scheme" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <Head
      pageName={pageName}
      pageDesc={pageDesc}
      pageImage={pageImage}
      pageType={pageType}
      pagePublished={pagePublished}
      pageUpdated={pageUpdated}
      schema={schema}
    />
  </head>

  <body>
    <div class="page-container">
      <slot />
    </div>

    <ThemeToggle />

    <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-QJC649ZTNK"></script>
    <script id="google-analytics" is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-QJC649ZTNK');
    </script>
  </body>
</html>
