---
import dayjs from 'dayjs';
import timezone from 'dayjs/plugin/timezone';
import Head from '@/components/Head.astro';
import '../global.css';

dayjs.extend(timezone);
dayjs.tz.setDefault('Asia/Taipei');

const currentLocale = Astro.currentLocale || 'tw';
const htmlLang = currentLocale === 'tw' ? 'zh-hant-tw' : 'en';

const {
  pageName,
  pageDesc,
  pageImage,
  pageType,
  pagePublished,
  pageUpdated,
  schema,
  robots,
  languageAlternates,
} = Astro.props;
---

<html lang={htmlLang}>
  <head>
    <script is:inline>
      // 舊主題名遷移：dim / forest → tide-dark，nord → tide-light
      const LEGACY = { dim: 'tide-dark', forest: 'tide-dark', nord: 'tide-light' };
      let saved = localStorage.getItem('theme');
      if (saved && LEGACY[saved]) {
        saved = LEGACY[saved];
        localStorage.setItem('theme', saved);
      }
      if (saved !== 'tide-dark' && saved !== 'tide-light') saved = null;

      const theme =
        saved ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'tide-dark' : 'tide-light');
      document.documentElement.setAttribute('data-theme', theme);

      // theme-color 必須跟著主題走，否則行動裝置的網址列會是另一套色
      document.addEventListener('DOMContentLoaded', () => {
        const meta = document.querySelector('meta[name="theme-color"]');
        const sync = () => {
          const t = document.documentElement.getAttribute('data-theme');
          if (meta) meta.setAttribute('content', t === 'tide-dark' ? '#07181A' : '#E7F0F1');
        };
        sync();
        new MutationObserver(sync).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
      });
    </script>
    <link rel="me" href="https://social.wildsky.cc/@wildsky" />
    <link rel="me" href="https://github.com/wildskyf" />
    <link rel="me" href="https://www.linkedin.com/in/wildsky/" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta content="dark light" name="color-scheme" />
    <meta name="theme-color" content="#07181A" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <Head
      pageName={pageName}
      pageDesc={pageDesc}
      pageImage={pageImage}
      pageType={pageType}
      pagePublished={pagePublished}
      pageUpdated={pageUpdated}
      schema={schema}
      robots={robots}
      languageAlternates={languageAlternates}
    />
  </head>

  <body>
    <!--
      THESIS: A decade of technical writing becomes a private folio descending through petrol water; it refuses the dashboard/HUD arrangement.
      OWN-WORLD: Teal-black water and wet paper, serif typography, hairlines, deckle strata, cropped monochrome marine silhouettes, scarce blood red and one coral beacon.
      STORY: The visitor recognizes Wildsky, reads the exact manifesto, scans real posts by date and topic, then continues into the archive.
      FIRST VIEWPORT: A 72px seal header, oversized two-line manifesto, article count, and the newest post cross the first moving depth boundary.
      FORM: Approved comp v8 canon; seed key approved-v8-canon.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <div class="page-container">
      <slot />
    </div>

    <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-QJC649ZTNK"></script>
    <script id="google-analytics" is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-QJC649ZTNK');
    </script>
  </body>
</html>
