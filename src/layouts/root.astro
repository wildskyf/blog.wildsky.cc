---
import dayjs from 'dayjs';
import timezone from 'dayjs/plugin/timezone';
import Head from '@/components/Head.astro';
import '../global.css';

dayjs.extend(timezone);
dayjs.tz.setDefault('Asia/Taipei');

const currentLocale = Astro.currentLocale || 'tw';
const htmlLang = currentLocale === 'tw' ? 'zh-hant-tw' : 'en';

const {
  pageName,
  pageDesc,
  pageImage,
  pageType,
  pagePublished,
  pageUpdated,
  schema,
  robots,
  languageAlternates,
} = Astro.props;
---

<html lang={htmlLang}>
  <head>
    <script id="google-analytics" is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
      });
      gtag('set', 'ads_data_redaction', true);
      gtag('js', new Date());
    </script>
    <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-QJC649ZTNK"></script>

    <script is:inline>
      // 舊主題名遷移：dim / forest → tide-dark，nord → tide-light
      const LEGACY = { dim: 'tide-dark', forest: 'tide-dark', nord: 'tide-light' };
      let saved = localStorage.getItem('theme');
      if (saved && LEGACY[saved]) {
        saved = LEGACY[saved];
        localStorage.setItem('theme', saved);
      }
      if (saved !== 'tide-dark' && saved !== 'tide-light') saved = null;

      const theme =
        saved ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'tide-dark' : 'tide-light');
      document.documentElement.setAttribute('data-theme', theme);

      // Background motion pause (MotionToggle); set before paint so nothing starts moving first
      if (localStorage.getItem('motion') === 'paused') document.documentElement.dataset.motion = 'paused';

      // theme-color 必須跟著主題走，否則行動裝置的網址列會是另一套色
      document.addEventListener('DOMContentLoaded', () => {
        const meta = document.querySelector('meta[name="theme-color"]');
        const sync = () => {
          const t = document.documentElement.getAttribute('data-theme');
          if (meta) meta.setAttribute('content', t === 'tide-dark' ? '#2A3843' : '#F2F4F5');
        };
        sync();
        new MutationObserver(sync).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
      });
    </script>
    <link rel="me" href="https://social.wildsky.cc/@wildsky" />
    <link rel="me" href="https://github.com/wildskyf" />
    <link rel="me" href="https://www.linkedin.com/in/wildsky/" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta content="dark light" name="color-scheme" />
    <meta name="theme-color" content="#2A3843" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <Head
      pageName={pageName}
      pageDesc={pageDesc}
      pageImage={pageImage}
      pageType={pageType}
      pagePublished={pagePublished}
      pageUpdated={pageUpdated}
      schema={schema}
      robots={robots}
      languageAlternates={languageAlternates}
    />
    <script is:inline>
      const sanitizedLocation = `${window.location.origin}${window.location.pathname}`;
      let sanitizedReferrer = '';

      if (document.referrer) {
        const referrer = new URL(document.referrer);
        sanitizedReferrer =
          referrer.origin === window.location.origin
            ? `${referrer.origin}${referrer.pathname}`
            : referrer.origin;
      }

      gtag('config', 'G-QJC649ZTNK', {
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
        send_page_view: false,
      });
      gtag('event', 'page_view', {
        page_location: sanitizedLocation,
        page_referrer: sanitizedReferrer,
        page_title: document.title,
      });
    </script>
  </head>

  <body>
    <!--
      THESIS: A decade of technical writing read as a slow descent through a blue-graphite water column; reading deeper sinks the page.
      OWN-WORLD: Graphite water, silver type, light shafts and dust, marine snow, bioluminescence, jellyfish, far shoals, a stone-needle floor; red only at a few focal points, gold the single warm note.
      STORY: The visitor recognizes Wildsky, reads the exact manifesto, scans real posts by date and topic, then continues into the archive.
      FIRST VIEWPORT: A translucent header with a dotted leader, the two-line manifesto over a drifting current line, an English HUD readout, and the newest post.
      FORM: Approved comp v9 canon (comp/index-v9.html).
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <div class="page-container">
      <slot />
    </div>
  </body>
</html>
