---
import PageLayout from './page.astro';
import PostList from '@/components/PostList.astro';
import { getTranslation } from '@/i18n/utils.ts';
import { formatReadingTime } from '@/utils';

type Locale = 'tw' | 'en';

type ListPost = {
  date: Date | string;
  slug: string;
  title: string;
  category?: string | null;
  tags?: string[];
  readingMinutes?: number | null;
};

type Props = {
  lang?: Locale;
  postList: ListPost[];
  previous_page_path?: string | null;
  next_page_path?: string | null;
  pageName?: string;
  pageDesc?: string;
  schema?: unknown;
  currentPage?: number;
  lastPage?: number;
  totalPosts?: number;
};

const {
  lang,
  postList,
  previous_page_path,
  next_page_path,
  pageName,
  pageDesc,
  schema,
  currentPage = 1,
  lastPage = 1,
  totalPosts,
} = Astro.props as Props;

const currentLocale = (Astro.currentLocale || lang || 'tw') as Locale;
const t = getTranslation(currentLocale);

const rows = postList.map((p) => ({
  ...p,
  readingTime: p.readingMinutes ? formatReadingTime(p.readingMinutes, lang) : null,
}));

const pad = (n: number) => String(n).padStart(2, '0');
const countLabel = totalPosts
  ? `${totalPosts} Entries / Page ${pad(currentPage)}`
  : `Page ${pad(currentPage)} / ${pad(lastPage)}`;
---

<PageLayout lang={lang} pageName={pageName} pageDesc={pageDesc} schema={schema}>
  <slot />

  <div class="chrome-inner">
    <div class="ds-hero">
      <span class="ds-hero-kicker">Descent<br />Log</span>
      <p class="ds-hero-manifesto" set:html={t.site.manifesto} />
      <span class="ds-hero-count">{countLabel}</span>
    </div>

    <PostList lang={lang} postList={rows} showLatest={currentPage === 1} />

    <nav class="ds-pager" aria-label={currentLocale === 'en' ? 'Pagination' : '分頁導覽'}>
      <span class="ds-pager-slot">
        {
          previous_page_path && (
            <a class="ds-btn ds-plate" href={previous_page_path}>
              {t.common.newerPosts}
            </a>
          )
        }
      </span>
      <span class="ds-pager-slot end">
        {
          next_page_path && (
            <a class="ds-btn ds-plate" href={next_page_path}>
              {t.common.olderPosts}
            </a>
          )
        }
      </span>
    </nav>
  </div>
</PageLayout>

<style>
  /* Hero：面板退場，改雙細線刻印帶。貴氣來自留白與細線，不是來自色塊。 */
  .ds-hero {
    position: relative;
    display: grid;
    grid-template-columns: var(--gutter-col) 1fr auto;
    align-items: end;
    gap: 24px;
    margin: 56px 0 4px;
    padding: 30px 0 26px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .ds-hero::before,
  .ds-hero::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: color-mix(in oklab, var(--rule) 55%, transparent);
  }
  .ds-hero::before {
    top: 4px;
  }
  .ds-hero::after {
    bottom: 4px;
  }

  .ds-hero-kicker {
    grid-column: 1;
    position: relative;
    padding-left: 18px;
    padding-bottom: 10px;
    font-family: var(--font-label);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    font-variant: small-caps;
    color: var(--fg-muted);
    line-height: 1.4;
  }

  .ds-hero-kicker::before {
    content: '';
    position: absolute;
    left: 0;
    top: 4px;
    width: 2px;
    height: 34px;
    background: var(--accent);
  }

  .ds-hero-manifesto {
    grid-column: 2;
    margin: 0;
    padding-bottom: 6px;
    font-family: var(--font-display);
    font-size: 27px;
    font-weight: 600;
    line-height: 1.62;
    letter-spacing: 0.02em;
    color: var(--fg);
  }

  /* 宣言的語意樞紐 —— 27px 大字，大字門檻 3.0，實測 3.83 ✓ */
  .ds-hero-manifesto :global(.pivot) {
    color: var(--accent-text);
    font-weight: 700;
    padding: 0 0.06em;
  }

  .ds-hero-count {
    grid-column: 3;
    align-self: end;
    white-space: nowrap;
    font-family: var(--font-label);
    font-size: 13px;
    font-variant: small-caps;
    letter-spacing: 0.06em;
    color: var(--fg-muted);
  }

  .ds-pager {
    margin-top: 56px;
    display: grid;
    grid-template-columns: var(--gutter-col) 1fr auto;
    align-items: center;
    gap: 16px;
  }

  .ds-pager-slot {
    grid-column: 2;
    justify-self: start;
  }
  .ds-pager-slot.end {
    grid-column: 3;
    justify-self: end;
  }

  .ds-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 58px;
    padding: 0 40px;
    font-family: var(--font-chrome);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--fg);
    text-decoration: none;
    cursor: pointer;
  }

  .ds-btn:hover {
    background: var(--accent-fill);
    color: var(--fg-on-accent);
    --stroke: var(--accent);
    --stroke-inner: color-mix(in oklab, var(--fg-on-accent) 42%, transparent);
  }

  @media (max-width: 1119px) {
    .ds-hero,
    .ds-pager {
      grid-template-columns: 96px 1fr auto;
    }
  }

  @media (max-width: 767px) {
    .ds-hero {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-top: 32px;
    }
    .ds-hero-kicker,
    .ds-hero-manifesto,
    .ds-hero-count {
      grid-column: 1;
    }
    .ds-hero-manifesto {
      font-size: 24px;
    }
    .ds-pager {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .ds-pager-slot {
      grid-column: 1;
    }
    .ds-pager-slot.end {
      grid-column: 2;
    }
    .ds-btn {
      width: 100%;
      padding: 0 16px;
      letter-spacing: 0.12em;
    }
  }
</style>
