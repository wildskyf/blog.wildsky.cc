---
import PageLayout from './page.astro';
import PostList from '@/components/PostList.astro';
import { getTranslation } from '@/i18n/utils.ts';
import { formatReadingTime } from '@/utils';

type Locale = 'tw' | 'en';

type ListPost = {
  date: Date | string;
  slug: string;
  title: string;
  category?: string | null;
  tags?: string[];
  readingMinutes?: number | null;
};

type Props = {
  lang?: Locale;
  postList: ListPost[];
  previous_page_path?: string | null;
  next_page_path?: string | null;
  pageName?: string;
  pageDesc?: string;
  schema?: unknown;
  currentPage?: number;
  lastPage?: number;
  totalPosts?: number;
  robots?: string;
};

const {
  lang,
  postList,
  previous_page_path,
  next_page_path,
  pageName,
  pageDesc,
  schema,
  currentPage = 1,
  lastPage = 1,
  totalPosts,
  robots,
} = Astro.props as Props;

const currentLocale = (Astro.currentLocale || lang || 'tw') as Locale;
const t = getTranslation(currentLocale);

const rows = postList.map((p) => ({
  ...p,
  readingTime: p.readingMinutes ? formatReadingTime(p.readingMinutes, lang) : null,
}));

// Who is writing: facts only, taken from the About page (owner request 2026-11-03)
const intro =
  currentLocale === 'en'
    ? {
        text: 'I’m Rance (Wildsky), a software engineer at Taiwan AI Labs. Lately I’ve been focused on AI agents, knowledge systems and self-hosting. I’ve been writing here since 2014: tech notes, life, and whatever I’m thinking about.',
        links: [
          { label: 'About me', href: '/en/about-en/' },
          { label: 'Experience', href: '/en/experiences-en/' },
        ],
      }
    : {
        text: '我是 Rance（范耿誌），在 Taiwan AI Labs 當軟體工程師，最近特別關注 AI agent、知識系統跟 self-hosting。這個部落格從 2014 年寫到現在，有技術筆記，也有生活跟一些想法。',
        links: [
          { label: '關於我', href: '/about/' },
          { label: '經歷與作品', href: '/experiences/' },
        ],
      };
// Keep CJK words whole when the intro wraps (same approach as the post titles)
const introSegmenter = new Intl.Segmenter(currentLocale === 'en' ? 'en' : 'zh-Hant', {
  granularity: 'word',
});
const introSegments = [...introSegmenter.segment(intro.text)];
const hasHan = (value: string) => /[\u3400-\u9fff]/u.test(value);
const manifestoParts =
  currentLocale === 'en'
    ? ['Faith in uncertainty, ', 'while engineering life with certainty']
    : ['信仰不確定性，', '同時用確定性工程過生活'];
const manifestoLabel = manifestoParts.join('');
---

<PageLayout lang={lang} pageName={pageName} pageDesc={pageDesc} schema={schema} robots={robots}>
  <slot />

  <div class="chrome-inner">
    <div class="ds-hero">
      {
        /* W in broken strokes: two spires with chipped joints, serif ticks and a waterline (comp v9) */
      }
      <svg class="ds-hero-sigil" viewBox="0 0 200 220" aria-hidden="true">
        <path d="M14 20 L58 196"></path>
        <path d="M58 196 L79 128"></path>
        <path d="M88 99 L100 62"></path>
        <path d="M100 62 L142 196"></path>
        <path d="M142 196 L158 145"></path>
        <path d="M166 118 L188 20"></path>
        <path class="thin" d="M2 20 L30 20"></path>
        <path class="thin" d="M174 20 L200 20"></path>
        <path class="line" d="M0 214 L200 214"></path>
        <path class="hair" d="M40 206 L120 206"></path>
      </svg>

      <h1 class="ds-hero-manifesto" aria-label={manifestoLabel}>
        {manifestoParts.map((part) => <span>{part}</span>)}
        {/* The current: a single drifting line under the manifesto */}
        <svg
          class="ds-hero-current"
          viewBox="0 0 1240 28"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <defs>
            <linearGradient id="ds-current-grad" x1="0" x2="1" y1="0" y2="0">
              <stop offset="0" style="stop-color: var(--glow); stop-opacity: 0"></stop>
              <stop offset="0.2" style="stop-color: var(--glow); stop-opacity: 1"></stop>
              <stop offset="0.65" style="stop-color: var(--fg); stop-opacity: 0.9"></stop>
              <stop offset="1" style="stop-color: var(--fg); stop-opacity: 0"></stop>
            </linearGradient>
          </defs>
          <path d="M0,16 C140,4 260,26 400,15 S680,4 820,14 S1100,26 1240,12"></path>
        </svg>
      </h1>
      <div class="ds-hero-intro">
        <p>
          {
            introSegments.map(({ segment, isWordLike }) =>
              isWordLike && hasHan(segment) ? <span class="ds-phrase">{segment}</span> : segment
            )
          }
        </p>
        <p class="ds-hero-links">
          {intro.links.map((link) => <a href={link.href}>{link.label}</a>)}
        </p>
      </div>
    </div>

    <PostList lang={lang} postList={rows} showLatest={currentPage === 1} />

    <nav class="ds-pager" aria-label={currentLocale === 'en' ? 'Pagination' : '分頁導覽'}>
      <span class="ds-pager-slot">
        {
          previous_page_path && (
            <a class="ds-btn ds-plate" href={previous_page_path}>
              {t.common.newerPosts}
            </a>
          )
        }
      </span>
      <span class="ds-pager-slot end">
        {
          next_page_path && (
            <a class="ds-btn ds-plate" href={next_page_path}>
              {t.common.olderPosts}
            </a>
          )
        }
      </span>
    </nav>
  </div>
</PageLayout>

<style>
  .ds-hero {
    position: relative;
    padding: 128px 0 84px;
    border-bottom: 1px solid var(--rule);
  }

  .ds-hero-sigil {
    position: absolute;
    right: 2%;
    top: 36px;
    width: min(360px, 40vw);
    height: auto;
    pointer-events: none;
    opacity: var(--env-sigil-op);
    fill: none;
    stroke: var(--fg);
    stroke-width: 3;
    stroke-linecap: square;
  }
  .ds-hero-sigil .thin {
    stroke-width: 1.5;
  }
  .ds-hero-sigil .line {
    stroke-width: 1;
  }
  .ds-hero-sigil .hair {
    stroke-width: 0.8;
  }

  .ds-hero-manifesto {
    position: relative;
    display: inline-block;
    margin: 0;
    font-family: var(--font-cjk-display);
    font-size: clamp(36px, 5.2vw, 64px);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.03em;
    background: var(--title-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .ds-hero-manifesto span {
    display: block;
    text-wrap: balance;
  }

  .ds-hero-current {
    position: absolute;
    left: -4%;
    right: -10%;
    bottom: -30px;
    width: 114%;
    height: 28px;
    overflow: visible;
    pointer-events: none;
  }
  .ds-hero-current path {
    fill: none;
    stroke: url(#ds-current-grad);
    stroke-width: 1.5;
    stroke-dasharray: 1400;
    stroke-dashoffset: 1400;
    animation: ds-current-in 2.6s var(--ease) 0.3s forwards;
  }
  @keyframes ds-current-in {
    to {
      stroke-dashoffset: 0;
    }
  }

  .ds-hero-intro {
    position: relative;
    z-index: 1;
    max-width: 34em;
    margin-top: 64px;
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.8;
    color: var(--fg-muted);
  }
  .ds-hero-intro p {
    margin: 0;
  }
  .ds-hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin-top: 14px !important;
  }
  .ds-hero-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--glow-text);
    /* underline, not a border: the 44px touch box would push a border far below the text */
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--glow) 45%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    line-height: 1.3;
    transition:
      color var(--t) var(--ease),
      text-decoration-color var(--t) var(--ease);
  }
  .ds-hero-links a::after {
    content: '→';
    margin-left: 0.3em;
  }
  .ds-phrase {
    white-space: nowrap;
  }
  .ds-hero-links a:hover,
  .ds-hero-links a:focus-visible {
    color: var(--fg);
    text-decoration-color: var(--glow);
  }

  .ds-pager {
    margin-top: 56px;
    display: grid;
    grid-template-columns: var(--gutter-col) 1fr auto;
    align-items: center;
    gap: 16px;
  }

  .ds-pager-slot {
    grid-column: 2;
    justify-self: start;
  }
  .ds-pager-slot.end {
    grid-column: 3;
    justify-self: end;
  }

  .ds-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 58px;
    padding: 0 40px;
    font-family: var(--font-label);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.055em;
    font-variant-caps: all-small-caps;
    font-feature-settings:
      'smcp' 1,
      'c2sc' 1;
    color: var(--fg);
    text-decoration: none;
    cursor: pointer;
  }

  .ds-btn:hover {
    background: transparent;
    color: var(--fg);
    --stroke: var(--glow);
    --stroke-inner: var(--ember);
  }

  @media (max-width: 1119px) {
    .ds-pager {
      grid-template-columns: 96px 1fr auto;
    }
  }

  @media (max-width: 767px) {
    .ds-hero {
      padding: 80px 0 56px;
      /* the current line and the W bleed past the column; clip them so the page never scrolls sideways */
      overflow-x: clip;
    }
    .ds-hero-manifesto {
      font-size: clamp(24px, 7.4vw, 34px);
    }
    .ds-hero-intro {
      margin-top: 52px;
      font-size: 17px;
    }
    .ds-hero-sigil {
      top: 40px;
      width: 46vw;
    }
    .ds-pager {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .ds-pager-slot {
      grid-column: 1;
    }
    .ds-pager-slot.end {
      grid-column: 2;
    }
    .ds-btn {
      width: 100%;
      padding: 0 16px;
      letter-spacing: 0.04em;
    }
  }
</style>
