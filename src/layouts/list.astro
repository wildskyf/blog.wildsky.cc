---
import PageLayout from './page.astro';
import PostList from '@/components/PostList.astro';
import { getTranslation } from '@/i18n/utils.ts';
import { formatReadingTime } from '@/utils';

type Locale = 'tw' | 'en';

type ListPost = {
  date: Date | string;
  slug: string;
  title: string;
  category?: string | null;
  tags?: string[];
  readingMinutes?: number | null;
};

type Props = {
  lang?: Locale;
  postList: ListPost[];
  previous_page_path?: string | null;
  next_page_path?: string | null;
  pageName?: string;
  pageDesc?: string;
  schema?: unknown;
  currentPage?: number;
  lastPage?: number;
  totalPosts?: number;
  robots?: string;
};

const {
  lang,
  postList,
  previous_page_path,
  next_page_path,
  pageName,
  pageDesc,
  schema,
  currentPage = 1,
  lastPage = 1,
  totalPosts,
  robots,
} = Astro.props as Props;

const currentLocale = (Astro.currentLocale || lang || 'tw') as Locale;
const t = getTranslation(currentLocale);

const rows = postList.map((p) => ({
  ...p,
  readingTime: p.readingMinutes ? formatReadingTime(p.readingMinutes, lang) : null,
}));

const countLabel = totalPosts
  ? currentLocale === 'en'
    ? `${totalPosts} articles`
    : `${totalPosts} 篇文章`
  : currentLocale === 'en'
    ? `Page ${currentPage} of ${lastPage}`
    : `第 ${currentPage} / ${lastPage} 頁`;
const manifestoParts =
  currentLocale === 'en'
    ? ['Faith in uncertainty, ', 'while engineering life with certainty']
    : ['信仰不確定性，', '同時用確定性工程過生活'];
const manifestoLabel = manifestoParts.join('');
---

<PageLayout lang={lang} pageName={pageName} pageDesc={pageDesc} schema={schema} robots={robots}>
  <slot />

  <div class="chrome-inner">
    <div class="ds-hero">
      <span class="ds-hero-anchor" aria-hidden="true"></span>
      <h1 class="ds-hero-manifesto" aria-label={manifestoLabel}>
        {manifestoParts.map((part) => <span>{part}</span>)}
      </h1>
      <span class="ds-hero-count">{countLabel}</span>
    </div>

    <PostList lang={lang} postList={rows} showLatest={currentPage === 1} />

    <nav class="ds-pager" aria-label={currentLocale === 'en' ? 'Pagination' : '分頁導覽'}>
      <span class="ds-pager-slot">
        {
          previous_page_path && (
            <a class="ds-btn ds-plate" href={previous_page_path}>
              {t.common.newerPosts}
            </a>
          )
        }
      </span>
      <span class="ds-pager-slot end">
        {
          next_page_path && (
            <a class="ds-btn ds-plate" href={next_page_path}>
              {t.common.olderPosts}
            </a>
          )
        }
      </span>
    </nav>
  </div>
</PageLayout>

<style>
  .ds-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    margin: 56px 0 4px;
    padding: 34px 0 30px 18px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .ds-hero::before,
  .ds-hero::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: color-mix(in oklab, var(--rule) 55%, transparent);
  }
  .ds-hero::before {
    top: 4px;
  }
  .ds-hero::after {
    bottom: 4px;
  }

  .ds-hero-anchor {
    position: absolute;
    left: 0;
    top: 28px;
    bottom: 26px;
    width: 1px;
    background: var(--accent);
  }

  .ds-hero-manifesto {
    grid-column: 1;
    margin: 0;
    font-family: var(--font-cjk-display);
    font-size: clamp(36px, 4.2vw, 56px);
    font-weight: 600;
    line-height: 1.28;
    letter-spacing: 0.008em;
    color: var(--fg);
  }

  .ds-hero-manifesto span {
    display: block;
  }

  .ds-hero-count {
    grid-column: 2;
    align-self: end;
    white-space: nowrap;
    font-family: var(--font-label);
    font-size: 15px;
    font-variant-caps: all-small-caps;
    font-feature-settings:
      'smcp' 1,
      'c2sc' 1;
    letter-spacing: 0.055em;
    color: var(--fg-muted);
  }

  .ds-pager {
    margin-top: 56px;
    display: grid;
    grid-template-columns: var(--gutter-col) 1fr auto;
    align-items: center;
    gap: 16px;
  }

  .ds-pager-slot {
    grid-column: 2;
    justify-self: start;
  }
  .ds-pager-slot.end {
    grid-column: 3;
    justify-self: end;
  }

  .ds-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 58px;
    padding: 0 40px;
    font-family: var(--font-label);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.055em;
    font-variant-caps: all-small-caps;
    font-feature-settings:
      'smcp' 1,
      'c2sc' 1;
    color: var(--fg);
    text-decoration: none;
    cursor: pointer;
  }

  .ds-btn:hover {
    background: transparent;
    color: var(--fg);
    --stroke: var(--accent);
    --stroke-inner: var(--ember);
  }

  @media (max-width: 1119px) {
    .ds-pager {
      grid-template-columns: 96px 1fr auto;
    }
  }

  @media (max-width: 899px) {
    .ds-hero {
      grid-template-columns: 1fr;
    }
    .ds-hero-count {
      grid-column: 1;
    }
  }

  @media (max-width: 767px) {
    .ds-hero {
      gap: 18px;
      margin-top: 32px;
      padding: 28px 0 24px 18px;
    }
    .ds-hero-manifesto {
      font-size: clamp(30px, 8vw, 38px);
    }
    .ds-pager {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .ds-pager-slot {
      grid-column: 1;
    }
    .ds-pager-slot.end {
      grid-column: 2;
    }
    .ds-btn {
      width: 100%;
      padding: 0 16px;
      letter-spacing: 0.04em;
    }
  }
</style>
