---
import dayjs from 'dayjs';
import Header from '@/components/Header.astro';
import SocialBar from '@/components/SocialBar.astro';
import BackgroundField from '@/components/BackgroundField.astro';
import RootLayout from './root.astro';

const currentLocale = Astro.currentLocale || 'tw';
const lang_code = currentLocale === 'tw' ? 'zh-Hant-TW' : 'en';
const footerNavLabel = currentLocale === 'en' ? 'Footer links' : '頁尾連結';

const {
  pageName,
  pageDesc,
  pageImage,
  pageType,
  pagePublished,
  pageUpdated,
  schema,
  robots,
  languageAlternates,
} = Astro.props;
---

<RootLayout
  pageName={pageName}
  pageDesc={pageDesc}
  pageImage={pageImage}
  pageType={pageType}
  pagePublished={pagePublished}
  pageUpdated={pageUpdated}
  schema={schema}
  robots={robots}
  languageAlternates={languageAlternates}
>
  <BackgroundField />

  <div id="page" class="ds-page">
    <Header pageName={pageName} />

    <main class="ds-main" lang={lang_code}>
      <slot />
    </main>

    <footer class="ds-footer" lang="en">
      <div class="chrome-inner ds-footer-inner">
        <nav aria-label={footerNavLabel}>
          <SocialBar />
        </nav>

        <span class="ds-copyright">2014—{dayjs().year()} &copy; All Rights Reserved</span>

        <p class="ds-footer-disclaimer">
          Wildsky can make mistakes. Always review before running the code.
        </p>
      </div>
    </footer>
  </div>
</RootLayout>

<style>
  .ds-page {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .ds-main {
    flex: 1 0 auto;
    padding: 0 0 96px;
  }

  .ds-footer {
    position: relative;
    z-index: 3;
    flex: none;
    background: transparent;
    border-top: 1px solid var(--rule);
    padding: 28px 0 34px;
  }

  .ds-footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 24px;
    row-gap: 16px;
  }

  /* --fg-faint 於 --bg-sunken 上實測 4.49，13px 小字未過 AA → 一律 --fg-muted（8.30） */
  .ds-copyright {
    justify-self: end;
    font-family: var(--font-meta);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.045em;
    color: var(--fg-muted);
  }

  .ds-footer-disclaimer {
    grid-column: 1 / -1;
    justify-self: center;
    margin: 0;
    color: var(--fg-muted);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.008em;
    text-align: center;
    text-wrap: balance;
  }

  @media (max-width: 767px) {
    .ds-footer-inner {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 12px;
    }

    .ds-footer-inner nav,
    .ds-copyright,
    .ds-footer-disclaimer {
      grid-column: 1;
      justify-self: center;
    }
  }
</style>
