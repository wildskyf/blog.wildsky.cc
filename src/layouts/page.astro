---
import dayjs from 'dayjs';
import Header from '@/components/Header.astro';
import SocialBar from '@/components/SocialBar.astro';
import RootLayout from './root.astro';

const currentLocale = Astro.currentLocale || 'tw';
const lang_code = currentLocale === 'tw' ? 'zh-Hant-TW' : 'en';

const { pageName, pageDesc, pageImage, pageType, pagePublished, pageUpdated } = Astro.props;
---

<RootLayout
  pageName={pageName}
  pageDesc={pageDesc}
  pageImage={pageImage}
  pageType={pageType}
  pagePublished={pagePublished}
  pageUpdated={pageUpdated}
>
  <div
    id="page"
    class={`
      min-h-screen
      flex flex-col
    `}
  >
    <Header />

    <main class="flex-grow flex justify-center items-start lg:py-4" lang={lang_code}>
      <div class="flex flex-col w-full max-w-full lg:max-w-4xl">
        <slot />
      </div>
    </main>

    <footer class="bg-base-300 text-white text-center pt-8 pb-10" lang="en">
      <div class="grid place-content-center">
        <SocialBar class="mb-4" />
      </div>

      <div class="text-gray-500 tracking-[0.03em]">
        2014-{dayjs().year()} &copy; All rights reserved
      </div>
    </footer>
  </div>
</RootLayout>
